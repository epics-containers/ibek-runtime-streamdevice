#! Generated with the help of Claude (Anthropic)
# Druck PACE5000 / PACE6000 pressure controller, one control module.
#
# Nothing is written to the instrument at start-up: each output record reads
# the instrument's current value (the @init handler in pace5000.proto), and
# there is no autosave. What the IOC shows is what the instrument has.
#
# Polling puts the instrument in remote, which disables its touch screen.
# To use the front panel, set $(P):POLL to Paused, then press $(P):LOCAL.
#
# % macro, P, Device prefix
# % macro, PORT, Asyn port for device
# % macro, CH, Control module: 1, or 2 for the second module of a PACE6000

# ===========================================================================
# Polling and remote/local
# ===========================================================================

record(bo, "$(P):POLL") {
  field(DESC, "Pause polling for local use")
  field(ZNAM, "Running")
  field(ONAM, "Paused")
  field(VAL, "0")
  field(PINI, "YES")
}

record(bo, "$(P):LOCAL") {
  field(DESC, "Give the front panel back")
  field(SCAN, "Passive")
  # command only, no readback: do not alarm before first write
  field(UDFS, "NO_ALARM")
  field(DTYP, "stream")
  field(OUT, "@pace5000.proto goLocal $(PORT)")
  field(ZNAM, "Idle")
  field(ONAM, "Local")
}

record(bo, "$(P):REMOTE") {
  field(DESC, "Lock the front panel")
  field(SCAN, "Passive")
  # command only, no readback: do not alarm before first write
  field(UDFS, "NO_ALARM")
  field(DTYP, "stream")
  field(OUT, "@pace5000.proto goRemote $(PORT)")
  field(ZNAM, "Idle")
  field(ONAM, "Remote")
}

# ===========================================================================
# Identity and errors
# ===========================================================================

record(waveform, "$(P):IDN") {
  field(DESC, "Identification string")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@pace5000.proto getIDN $(PORT)")
  field(FTVL, "CHAR")
  field(NELM, "128")
}

# Each read pops one error from the instrument's 5-entry queue, so polling
# shows errors as they happen; "0, No error" when the queue is empty.
record(waveform, "$(P):ERROR_RBV") {
  field(DESC, "Last error from the error queue")
  field(SCAN, "5 second")
  field(SDIS, "$(P):POLL")
  field(DTYP, "stream")
  field(INP, "@pace5000.proto getError $(PORT)")
  field(FTVL, "CHAR")
  field(NELM, "128")
}

record(bo, "$(P):CLEARSTATUS") {
  field(DESC, "Clear status and error queue")
  field(SCAN, "Passive")
  # command only, no readback: do not alarm before first write
  field(UDFS, "NO_ALARM")
  field(DTYP, "stream")
  field(OUT, "@pace5000.proto clearStatus $(PORT)")
  field(ZNAM, "Idle")
  field(ONAM, "Clear")
}


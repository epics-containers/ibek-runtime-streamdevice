#record(calcout, "$(device):REPORTSEND") {
record(calcout, "$(device):REPORT") {
  field(DESC, "Retrieves summary report")
  field(SCAN, "2 second")
  field(DTYP, "stream")
  field(CALC, "1")
  field(OUT, "@CanberraG64.protocol report($(device):MSGNUM) $(port) 0")
  field(FLNK, "$(device):RATE")
}

# Dose rate
#% archiver 2 Monitor
#% controldesk Dose Rate readback
record(ai, "$(device):RATE") {
  field(DESC, "Dose Rate")
  field(DTYP, "Soft Channel")
  field(SCAN, "Passive")
  field(INP,  "$(device):REPORT.A")
  field(EGU, "mSv/h")
  field(PREC, "3")
#  field(HOPR, "10000")
  field(LOPR, "0")
  field(HIGH, "400")
  field(HIHI, "10000")
  field(LOLO, "0.005")
  field(HSV, "MINOR")
  field(HHSV, "MAJOR")
  field(LLSV, "MAJOR")
  field(ADEL, "$(adel)")
  field(FLNK, "$(device):DOSE")
}

# Accumulated dose
#% archiver 2 Monitor
#% controldesk Acuumulated Dose readback
record(calc, "$(device):DOSE") {
  field(DESC, "Accumulated Dose")
  field(INPA, "$(device):RATE MS")
  field(INPB, "$(device):DOSE")
  field(CALC, "B+(A/1800)")
  field(EGU, "mSv")
  field(PREC, "3")
  field(ADEL, "$(adel)")
  field(FLNK, "$(device):RATELOG")
}

# Alternative rate value
record(calc, "$(device):RATELOG") {
  field(DESC, "log RATE")
  field(EGU, "log")
  field(CALC, "LOG(A)")
  field(INPA, "$(device):RATE MS")
  field(HOPR, "2")
  field(LOPR, "-2")
  field(HIGH, "0.87506")
  field(HIHI, "4.0")
  field(LOLO, "-2.30103")
  field(HSV, "MINOR")
  field(HHSV, "MAJOR")
  field(LLSV, "MAJOR")
  field(SCAN, "Passive")
  field(FLNK, "$(device):ALMSTA")
}


# Overall Status
# % archiver 10 Monitor
record(calc, "$(device):STA") {
  field(DESC, "Calculate Status")
  field(CALC, "A<<12 + B<<4 + C<<2")
  field(INPA, "$(device):ALMSTASEVR NPP MS")
  field(INPB, "$(device):EQPSTASEVR NPP MS")
  field(INPC, "$(device):PARAMMODE NPP MS")
  field(SCAN, "Passive")
  field(FLNK, "$(device):MSGNUM")
}


#% archiver 10 Monitor
#record(bo, "$(device):RESETSEND") {
record(bo, "$(device):RESET") {
  field(DESC, "Reset Alarms")
  field(DTYP, "stream")
  field(OUT, "@CanberraG64.protocol reset($(device):MSGNUM) $(port) 0")
  field(ZNAM, "Off")
  field(ONAM, "Reset")
  field(FLNK, "$(device):MSGNUM")
}

#################
# Dose reset mechanism
# Allow visibility of reset button in EDM.
# Does not actually disable reset record.
record(bo, "$(device):RESETENA") {
  field(DESC, "Visibility of Reset")
  field(HIGH, "2.0")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(VAL, "0")
}

# Reset accumulated dose
record(bo, "$(device):DOSERESET") {
  field(DESC, "Reset Accumulated Dose")
  field(OUT, "$(device):DOSE")
  field(FLNK, "$(device):RESETTIME:AS")
}

# Autosave time of reset
record(stringin, "$(device):RESETTIME:AS")
{
  field(DESC, "Autosaved reset time")
  field(DTYP, "Soft Timestamp")
  field(INP, "@%Y/%m/%d %H:%M:%S")
  field(FLNK, "$(device):RESETTIME")
}

# Store new reset time or readback reset time from autosaved value.
record(stringin, "$(device):RESETTIME")
{
  field(DESC, "Time and date of reset")
  field(PINI, "YES")
  field(INP, "$(device):RESETTIME:AS")
}

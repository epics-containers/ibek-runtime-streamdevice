## 
## \file microlab500half.vdb
## \brief Control half of a Microlab 500 syringe pump
## \details Control and monitor one syringe and one valve.
##          Has a soft motor for the syringe.
##          Implements continuous pumping function.
##
## \author Giles Knap, Andrew Wilson
##

## Make STARTUP available to call from higher level template


## Pickup tweak
record(ao, "$(_P)$(_R):$(_SIDE):MOVOUT") {
  field(DESC, "Control left syringe pickup")
  field(DTYP, "stream")
  field(OUT, "@microlab500.proto pickup($(_SIDEPARM)) $(_PORT)")
}
## Dispense tweak
record(ao, "$(_P)$(_R):$(_SIDE):MOVIN") {
  field(DESC, "Control left syringe dispense")
  field(DTYP, "stream")
  field(OUT, "@microlab500.proto dispense($(_SIDEPARM)) $(_PORT)")
}

## Pickup or dispense tweak size
record(ao, "$(_P)$(_R):$(_SIDE):STEP") {
  field(PREC, "0")
  field(EGU, "Steps")
  field(VAL, "50")
}

## User input for raw speed
record(longout, "$(_P)$(_R):$(_SIDE):SPEED") {
  field(VAL, "9")
  field(OUT, "$(_P)$(_R):$(_SIDE):SETSPEED PP")
  field(EGU, "s/stroke")
}

## ??
record(calcout, "$(_P)$(_R):$(_SIDE):CALC") {
  field(DTYP, "Soft Channel")
  field(CALC, "A")
  field(INPA, "$(_P)$(_R):$(_SIDE):STEP.VAL PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

## Set raw speed
record(longout, "$(_P)$(_R):$(_SIDE):SETSPEED") {
  field(DESC, "Control speed of $(_SIDE) syringe")
  field(DTYP, "stream")
  field(OUT, "@microlab500.proto speed($(_SIDEPARM)) $(_PORT)")
  field(DRVH, "250") # Maximum accepted by device
  field(DRVL, "0")
  field(EGU, "s/stroke")
}

##  \name Return steps
##  \{

##  User input for return steps
record(longout, "$(_P)$(_R):$(_SIDE):RETURN") {
  field(VAL, "0")
  field(OUT, "$(_P)$(_R):$(_SIDE):SETRETURN PP")
}
## Write return steps to hardware
record(longout, "$(_P)$(_R):$(_SIDE):SETRETURN") {
  field(DESC, "Control backuoff return steps")
  field(DTYP, "stream")
  field(OUT, "@microlab500.proto return($(_SIDEPARM)) $(_PORT)")
  field(DRVH, "9")
  field(DRVL, "0") # Controller will not accept values >= 10
  field(EGU, "steps")
}
## \}

##  Read current syringe position
record(ai, "$(_P)$(_R):$(_SIDE):GETSPOS") {
  field(DESC, "Get syringe position")
  field(DTYP, "stream")
  field(INP, "@microlab500.proto positionS($(_SIDEPARM)) $(_PORT)")
  field(EGU, "Steps")
}

##

record(bo, "$(P)$(Q):DISABLE") {
  field(DESC, "Disable comms")
  field(PINI, "YES")
  field(VAL, "$(DISABLED=0)")
  field(ZNAM, "Enabled")
  field(ONAM, "Disabled")
}

record(stringin, "$(P)$(Q):ERR") {
  field(DESC, "Error message")
  field(PINI, "YES")
  field(VAL, "No Error")
}

record(calc, "$(P)$(Q):AUTOTUNE:DISA")
{
  field(DESC, "Disable autotune records")
  field(INPA, "$(P)$(Q):MULTILOOP")
  field(CALC, "!A")
}

record(bo, "$(P)$(Q):MULTILOOP") {
  field(DESC, "Multiloop controller")
  field(ZNAM, "No")
  field(ONAM, "Yes")
  field(VAL, "$(MULTILOOP=0)")
  field(PINI, "YES")
  field(FLNK, "$(P)$(Q):AUTOTUNE:DISA")
}

	field(DESC, "Autotune Output Low Limit")
	field(DTYP,"asynInt32")
	field(OUT,"@asyn(Eurotherm_$(PORT)_$(ADDR)_0_Wr_ATUNE,5,1000)MODBUS_DATA")

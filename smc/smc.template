  field(OUTD, "$(P):STS:POINT:UPPER.PREC PP")
  field(OUTE, "$(P):SET:POINT:UPPER.PREC")
  field(OUTF, "$(P):SET:POINT:LOWER.PREC")
  field(OUTG, "$(P):STS:PMCURRENT.PREC")
  field(CLCG, "(A=1)?4:3")
  field(CLCH, "(A=1)?4:3")
  field(CLCI, "(A=1)?4:3")
  field(CLCJ, "(A=1)?4:3")
  field(OUTH, "$(P):LIM:SETPOINT.PREC")
  field(OUTI, "$(P):SET:DMD:POINT:UPPER.PREC")
  field(OUTJ, "$(P):SET:DMD:POINT:LOWER.PREC")
}

# ///
# /// To propagate the unit name for the current units mode to the quench record.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:QUENCH") {
  field(DTYP, "Soft Channel")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):STS:QUENCH:CURRENT.EGU")
  field(FLNK, "$(P):PROP:DMD:SETPOINT:LOWER")
}

# ///
# /// To propagate the unit name for the current units mode to the record to set the upper set point.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:SETUPPER") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):PROP:UNIT:STSPMCURRENT")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):SET:POINT:UPPER.EGU")
}

# ///
# /// To propagate the unit name for the current units mode to the upper set point record.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:STSUPPER") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):PROP:UNIT:STSLOWER")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):STS:POINT:UPPER.EGU")
}

# ///
# /// To propagate the unit name for the current units mode to the lower set point record.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:STSLOWER") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):PROP:UNIT:QUENCH")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):STS:POINT:LOWER.EGU")
}

# ///
# /// To propagate the unit name for the current units mode to the record to set the lower set point.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:SETLOWER") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):PROP:UNIT:STSUPPER")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):SET:POINT:LOWER.EGU")
}

# ///
# /// Propagation of the engineering units to the record for whether the unit is in current or field mode 
# /// when the units mode changes.
# /// Needed because we cannot DFAN a string.
# ///
record(stringin, "$(P):PROP:UNIT:IORF") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):SCALC:IOFUNITS")
}

# ///
# /// Call the protocol function to run the N status command.
# ///
record(stringin, "$(P):GET:OUTPARAMS:FIELD") {
  field(DTYP, "stream")
  field(FLNK, "$(P):FAN:OUTPARAMS:FIELD")
  field(INP, "@smc.protocol getOutputParametersField($(P)) $(TY)")
  field(SCAN, "Passive")
  field(DESC, "N status GET")
}

# ///
# /// The persistent mode current.  The persistent mode operation is a feature that is not implemented
# /// on the DLS I06 superconducting magnet.  However this value still seems to be set meaningfully.
# /// The value is obtained from the N command.
# ///
record(ai, "$(P):STS:PMCURRENT") {
  field(DTYP, "Soft Channel")
  field(EGU, "A")
  field(PREC, "3")
  field(HHSV, "MAJOR")
}

# ///
# /// To propagate the unit name for the current units mode to the persistent mode record.
# /// Needed because no sfanout record type exists.
# ///
record(stringout, "$(P):PROP:UNIT:STSPMCURRENT") {
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):PROP:UNIT:SETLOWER")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):STS:PMCURRENT.EGU")
}

# ///
# /// To calculate the units mode status.
# ///
# The calculation result seems to have to use
# the ONAME and ZNAME of the binary record, if
# they are in use.
record(scalcout, "$(P):SCALC:IOFUNITS") {
  field(DTYP, "Soft Channel")
  field(CALC, "AA=='F'?'T':'A'")
  field(INAA, "$(P):PROP:UNIT:IORF")
  field(OUT, "$(P):STS:UNITS.VAL")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# ///
# /// This record controls regular scanning of the O status command.  
# /// The equivalent GET record does the actual work of issuing the protocol command.
# ///
record(stringout, "$(P):SCN:OPER:PARAMS") {
  field(SCAN, "10 second")
  field(FLNK, "$(P):GET:OPER:PARAMS")
  field(DESC, "O status scan")
}

# ///
# /// This record controls the scanning rate of the S status command.  It does not run it.
# /// That is done by the equivalent GET record.
# ///
record(stringout, "$(P):SCN:POINTSTATUS") {
  field(SCAN, "10 second")
  field(FLNK, "$(P):GET:POINTSTATUS")
  field(DESC, "S status scan")
}

# ///
# /// This record controls how often the K status is scanned.  
# /// The actual work is done by the equivalent-named GET record.
# ///
record(stringout, "$(P):SCN:CURRENTSTATUS") {
  field(SCAN, "10 second")
  field(FLNK, "$(P):GET:CURRENTSTATUS")
  field(DESC, "K status scan")
}

# ///
# /// G status fanout.  Force processsing of records that use the reply from the G status command.
# ///
record(fanout, "$(P):FAN:OUTPARAMS:CURRENT") {
  field(LNK1, "$(P):STS:RAMP:TARGET")
  field(LNK2, "$(P):STS:CURRENT")
  field(LNK3, "$(P):STS:VOLTAGE")
  field(LNK4, "$(P):STS:RAMP:AORV")
  field(DESC, "G status fanout")
}

# ///
# /// N status fanout.  Force processsing of records that use the reply from the N status command.
# ///
record(fanout, "$(P):FAN:OUTPARAMS:FIELD") {
  field(LNK1, "$(P):PROP:UNIT:IORF")
  field(LNK2, "$(P):STS:PMCURRENT")
  field(LNK3, "$(P):STS:VOLTAGE")
  field(LNK4, "$(P):STS:RAMP:AORV")
  field(DESC, "N status fanout")
}

# ///
# /// O status fanout.  Force processsing of records that use the reply from the O status command.
# ///
record(fanout, "$(P):FAN:OPER:PARAMS") {
  field(LNK1, "$(P):STS:RAMP:RATE")
  field(LNK2, "$(P):STS:RAMP:DIR")
  field(LNK3, "$(P):STS:FPLOCK")
  field(LNK4, "$(P):STS:HEATER:CURRENT")
  field(LNK5, "$(P):STS:CALIBRATION")
  field(LNK6, "$(P):STS:UNITS")
  field(DESC, "O status fanout")
}

# 
# To test running the K command.  Write to the
# PROC field of this to fire off a single
# update of the K status command.
#
record(stringout, "$(P):TST:CURRENTSTATUS") {
  field(SCAN, "Passive")
  field(FLNK, "$(P):GET:CURRENTSTATUS")
  field(DESC, "K status test/debug")
}

# To test running the O command.  Write to the PROC field for a single shot
# at the O status command.
record(stringout, "$(P):TST:OPER:PARAMS") {
  field(SCAN, "Passive")
  field(FLNK, "$(P):GET:OPER:PARAMS")
  field(DESC, "O status test/debug")
}

# To Test running the S command.  For a single shot at running the S command
# write to the PROC field.
record(stringout, "$(P):TST:POINTSTATUS") {
  field(SCAN, "Passive")
  field(FLNK, "$(P):GET:POINTSTATUS")
  field(DESC, "S status test/debug")
}

# ///
# /// Controls the scanning rate of the N status command.
# /// This scanning rate is slightly higher than others because
# /// it updates the readouts at the top of the GUI screen.
# /// The smc is very slow to respond, and high scanning rates are problematic.
# ///
record(stringout, "$(P):SCN:OUTPARAMS:FIELD") {
  field(DESC, "N status scan")
  field(SCAN, "5 second")
  field(FLNK, "$(P):GET:OUTPARAMS:FIELD")
}

# To test running the N command. Write to the proc field to get the GET record
# processed once.
record(stringout, "$(P):TST:OUTPARAMS:FIELD") {
  field(DESC, "N status test/debug")
  field(SCAN, "Passive")
  field(FLNK, "$(P):GET:OUTPARAMS:FIELD")
}

# ///
# /// Controls the scanning rate of the G status command.
# /// The smc is very slow to respond, and high scanning rates are problematic,
# /// causing timeouts.
# ///
record(stringout, "$(P):SCN:OUTPARAMS:CURRENT") {
  field(SCAN, "10 second")
  field(FLNK, "$(P):GET:OUTPARAMS:CURRENT")
  field(DESC, "G status scan")
}

# To test running the G command.  Write to the proc field of this record
# for a one shot process of the GET record which
# actually runs the protocol command.
record(stringout, "$(P):TST:OUTPARAMS:CURRENT") {
  field(SCAN, "10 second")
  field(FLNK, "$(P):GET:OUTPARAMS:CURRENT")
  field(DESC, "G status test/debug")
}

# To capture bits of mismatching protocol.
# Was used during development, but did not work.
record(stringin, "$(P):DBG:PROTOCOL:MISMATCH") {
  field(DESC, "Mismatching protocol string.")
  field(DTYP, "Soft Channel")
}

# For use during development.  Allows direct communication and reply
# of the RS232 comms protocol.
record(asyn, "$(P):DBG:ASYN:DEBUG") {
}

# ///
# /// The maximum field allowed now, i.e. the current field limit.
# /// This limit functionality is implemented in the EPICS database, external to the SMC.
# /// This limit changes as the operation mode of the magnet (collaboration of axes together)
# /// changes.
# ///
# %autosave 1 VAL
record(ai, "$(P):LIM:FIELD:NOW") {
  field(DESC, "Current max field")
  field(EGU, "T")
  field(PINI, "NO")
  field(VAL, "0")
  field(FLNK, "$(P):CALC:LIM:CURRENT:NOW")
  field(PREC, "4")
}

# ///
# /// The maximum current allowed now, i.e. the current current limit.
# /// Initialised to be zero.  Only once we have the calibration factor can we be sure of 
# /// limiting the current successfully. 
# /// This limit functionality is implemented in the EPICS database, external to the SMC.
# /// This limit changes as the operation mode of the magnet (collaboration of axes together)
# /// changes.
# ///
record(ai, "$(P):LIM:CURRENT:NOW") {
  field(PINI, "NO")
  field(VAL, "0")
  field(FLNK, "$(P):TRNSFM:LIM:CURRENT:NOW")
  field(PREC, "3")
  field(EGU, "A")
}

# ///
# /// Enforce the ramp rate limit.  This has to be done in current units, because that is all
# /// the SMC understands for ramp rate.
# /// This limit functionality is implemented in the EPICS database, external to the SMC.
# /// If the demand value exceeds the limit, set the demand value to be equal to the limit.
# /// Use OCAL so the value is only output when the calibration factor is non-zero, 
# /// because the whole of the calculation is invalid if the device calibration factor has not been set.
# ///
record(calcout, "$(P):CALC:RAMPRATE:LIMCHECK") {
  field(DESC, "Ramp rate limit check")
  field(DTYP, "Soft Channel")
  field(CALC, "(A<=B)?A:B")
  field(INPA, "$(P):SET:DMD:RAMPRATE:APS.VAL")
  field(INPB, "$(P):LIM:RAMPRATE:APS NPP MS")
  field(INPC, "$(P):STS:CALIBRATION")
  field(OUT, "$(P):SET:RAMP:RATE PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use CALC")
  field(OCAL, "(C>0)?1:0")
}

# ///
# /// Limit to the ramp rate in units of Tesla per minute.
# /// This limit functionality is implemented in the EPICS database, external to the SMC unit.
# ///
record(ao, "$(P):LIM:RAMPRATE:TPM") {
  field(DESC, "Ramp rate limit")
  field(PINI, "NO")
  field(FLNK, "$(P):CALC:LIM:RAMPRATE:TPS")
  field(VAL, "$(RAMPRATELIM)")
  field(OUT, "$(P):STS:RAMPRATE:TPM.HIHI")
  field(PREC, "6")
  field(EGU, "T/min")
}

# ///
# /// The ramp rate limits are actually defined in Tesla per minute.  
# /// This record converts to Tesla per second.
# /// It is part of the implementation of the limits to the ramp rate in the EPICS database.
# ///
record(calcout, "$(P):CALC:LIM:RAMPRATE:TPS") {
  field(DESC, "Ramp rate limit in T/s")
  field(CALC, "A/60")
  field(INPA, "$(P):LIM:RAMPRATE:TPM NPP MS")
  field(OUT, "$(P):LIM:RAMPRATE:TPS PP")
}

# ///
# /// The ramp rate limits are actually defined in Tesla per minute.
# /// This record holds the ramp rate limit in Tesla per second.
# /// It is part of the implementation of the limits to the ramp rate in EPICS.
# ///
record(ai, "$(P):LIM:RAMPRATE:TPS") {
  field(DESC, "Limit to ramp rate in T/s")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):CALC:LIM:RAMPRATE:APS PP")
  field(EGU, "T/s")
  field(PREC, "6")
}

# ///
# /// This record converts from Tesla per second to Amps per second.
# /// It is part of the implementation of the limits to the ramp rate in EPICS.
# ///
record(calcout, "$(P):CALC:LIM:RAMPRATE:APS") {
  field(DESC, "Ramp rate conversion")
  field(CALC, "A/B")
  field(INPA, "$(P):LIM:RAMPRATE:TPS.VAL")
  field(INPB, "$(P):STS:CALIBRATION NPP MS")
  field(OUT, "$(P):LIM:RAMPRATE:APS PP MS")
  field(PREC, "8")
}

# ///
# /// To hold the ramp rate limit in Amps per second.
# /// The ramp rate limits are actually defined in Tesla per minute but the 
# /// smc unit only understands Amps per second.
# ///
record(ao, "$(P):LIM:RAMPRATE:APS") {
  field(DESC, "Ramp rate limit in A/s")
  field(DTYP, "Soft Channel")
  field(OUT, "$(P):STS:RAMP:RATE.HIHI PP")
  field(PREC, "5")
  field(EGU, "A/s")
}

# ///
# /// Record to hold/set demand ramp rate in A/s.
# /// If the demanded value is too high other records will alter it before
# /// they pass it on to be processed by the record to make the protocol call.
# ///
record(ai, "$(P):SET:DMD:RAMPRATE:APS") {
  field(DESC, "Demand ramp rate SET")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):CALC:RAMPRATE:LIMCHECK")
  field(PREC, "5")
  field(EGU, "A/s")
}

# ///
# /// Converts the demanded ramp rate in tesla per second to amps per second.
# ///
record(calcout, "$(P):CALC:DMD:RAMPRATE:APS") {
  field(CALC, "A/B")
  field(INPA, "$(P):SET:DMD:RAMPRATE:TPS.VAL")
  field(INPB, "$(P):STS:CALIBRATION")
  field(OUT, "$(P):SET:DMD:RAMPRATE:APS.VAL PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# ///  
# /// To hold the demand ramp rate in Tesla per second.
# ///
record(ai, "$(P):SET:DMD:RAMPRATE:TPS") {
  field(DESC, "Ramp rate SET")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):CALC:DMD:RAMPRATE:APS")
  field(PREC, "6")
  field(EGU, "T/min")
}

# ///
# /// To convert the demanded ramp rate from Tesla per minute to Tesla per second.
# ///
record(calcout, "$(P):CALC:DMD:RAMPRATE:TPS") {
  field(CALC, "A/60")
  field(INPA, "$(P):SET:DMD:RAMPRATE:TPM.VAL")
  field(OUT, "$(P):SET:DMD:RAMPRATE:TPS.VAL PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# /// 
# /// To set/hold the demand ramp rate in Tesla per minute.  
# ///
record(ai, "$(P):SET:DMD:RAMPRATE:TPM") {
  field(DESC, "Ramp rate SET")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):CALC:DMD:RAMPRATE:TPS")
  field(PREC, "6")
  field(EGU, "T/min")
}

# ///
# /// To convert the ramp rate reported by the unit from Amps per second to Tesla per second.
# ///
record(calcout, "$(P):CALC:STS:RAMPRATE:TPS") {
  field(DESC, "Ramp rate conversion")
  field(CALC, "A*B")
  field(INPA, "$(P):STS:RAMP:RATE")
  field(INPB, "$(P):STS:CALIBRATION")
  field(OUT, "$(P):STS:RAMPRATE:TPS.VAL PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# ///
# /// To hold the ramp rate reported by the unit in Tesla per second.
# ///
record(ai, "$(P):STS:RAMPRATE:TPS") {
  field(DESC, "Ramp rate")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P):CALC:STS:RAMPRATE:TPM")
  field(PREC, "6")
  field(EGU, "T/s")
}

record(calcout, "$(P):CALC:STS:RAMPRATE:TPM") {
  field(DESC, "Ramp rate conversion")
  field(CALC, "A*60")
  field(INPA, "$(P):STS:RAMPRATE:TPS.VAL")
  field(OUT, "$(P):STS:RAMPRATE:TPM.VAL PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# ///
# /// To hold the ramp rate reported by the unit in Tesla per minute.
# /// Please note, this is the ramp rate at which a ramp will be performed
# /// when a set point target is selected.  It does not necessarily mean
# /// the magnet is ramping currently.
# ///
record(ai, "$(P):STS:RAMPRATE:TPM") {
  field(DESC, "Ramp rate")
  field(DTYP, "Soft Channel")
  field(PREC, "6")
  field(EGU, "T/min")
  field(HHSV, "MAJOR")
}

# ///
# /// Part of the EPICS implementation of the current limits.  Because the unit
# /// reports currents in fixed intervals, the current reported will probably never
# /// be exactly the limit, so this value decides the level of uncertainty.
# ///
record(ai, "$(P):LIM:CURR:DEADBAND") {
  field(PINI, "YES")
  field(VAL, "$(LIMCURRDB)")
  field(PREC, "3")
}

# ///
# /// This is the busy record for one SMC device.
# /// It is needed by GDA to allow it to set actions going and wait for a call back when
# /// the device is ready.
# ///
record(busy, "$(P):BSY") {
  field(DESC, "Busy record for for one SMC.")
}

# ///
# /// Record to change the state of the busy record to done.
# /// This does not need to be a complicated calculation at present but the
# /// record has to pass on this CA link for the busy mechanism to work.  The calculations are
# /// done in other records.
# ///
record(calcout, "$(P):CALC:BSY:DONE") {
  field(OUT, "$(P):BSY CA")
  field(DESC, "Checks if done")
  field(CALC, "0")
}

# ///
# /// Record to set the busy record to busy.
# /// This record does not calculate anything; that is done by other records.
# ///
record(calcout, "$(P):CALC:BSY:BUSY") {
  field(OUT, "$(P):BSY PP")
  field(DESC, "Sets busy status")
  field(CALC, "1")
}

# ///
# /// Part of the implementation of field/current limits in the EPICS database (external to the SMC unit).
# /// The maximum allowed field in this coil ever.
# /// The limit at any time depends on what operation mode is in force but this
# /// is the overall limit.
# ///
record(ai, "$(P):LIM:FIELD:UNIAXIS") {
  field(DESC, "Maximum field")
  field(EGU, "T")
  field(PINI, "YES")
  field(VAL, "$(FIELDLIMUNI)")
  field(PREC, "4")
}

# ///
# /// Part of the implementation of field/current limits in the EPICS database (external to the SMC unit).
# /// The maximum allow field in this coil when in vector operation mode (current in all 3 axis to give any direction of field).
# ///
record(ai, "$(P):LIM:FIELD:VECTOR") {
  field(DESC, "Maximum field")
  field(EGU, "T")
  field(PINI, "YES")
  field(VAL, "$(FIELDLIMVEC)")
  field(PREC, "4")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// To hold the operation mode demanded when working with other axes.
# /// Uniaxis OTHER:	Only one coil is in use, and it is not this one.  Field is along an axis direction not controlled by
# ///			PVs instantiated from the template along with this one.
# /// Uniaxis THIS:	Only this coil is in use.  Field is along the axis controlled by PVs instantiated from the template
# ///			along with this one.
# /// Vector:		All 3 coils are in use at once.  The field can be in any direction.
# ///
# /// Changing between operation modes can only be done when the current is zero and none of the units are ramping.
# ///
record(mbbi, "$(P):DMD:MAGMODE") {
  field(FLNK, "$(P):CALC:LIM:CURR:ZERO")
  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(ZRST, "Uniaxis OTHER")
  field(ONST, "Uniaxis THIS")
  field(TWST, "Vector")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// To hold the current operation mode in respect of coils/axes working together or not.
# /// Uniaxis OTHER:	Only one coil is in use, and it is not this one.  Field is along an axis direction not controlled by
# ///			PVs instantiated from the template along with this one.
# /// Uniaxis THIS:	Only this coil is in use.  Field is along the axis controlled by PVs instantiated from the template
# ///			along with this one.
# /// Vector:		All 3 coils are in use at once.  The field can be in any direction.
# ///
# %autosave 1 VAL
record(mbbi, "$(P):STS:MAGMODE") {
  field(PINI, "NO")
  field(FLNK, "$(P):FAN:MAGMODE")
  field(VAL, "0")
  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(ZRST, "Uniaxis OTHER")
  field(ONST, "Uniaxis THIS")
  field(TWST, "Vector")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// To calculate the field limit when magnet is in Vector operation mode as part of changing between operation modes.
# ///
record(calcout, "$(P):CALC:LIMIT:VECTOR") {
  field(CALC, "A==2?1:0")
  field(INPA, "$(P):STS:MAGMODE")
  field(INPB, "$(P):LIM:FIELD:VECTOR")
  field(OUT, "$(P):LIM:FIELD:NOW PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "B")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Propagates a change in operation mode.
# ///
record(fanout, "$(P):FAN:MAGMODE") {
  field(LNK1, "$(P):CALC:LIMIT:UNITHIS")
  field(LNK2, "$(P):CALC:LIMIT:UNIOTHER")
  field(LNK3, "$(P):CALC:LIMIT:VECTOR")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// To convert the current field limit to an equivalent current limit for this axis.
# ///
record(calcout, "$(P):CALC:LIM:CURRENT:NOW") {
  field(CALC, "A/B")
  field(INPA, "$(P):LIM:FIELD:NOW")
  field(INPB, "$(P):STS:CALIBRATION")
  field(OUT, "$(P):LIM:CURRENT:NOW PP")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Calculation when changing mode, imposing conditions on being allowed to do so.
# /// Tests to make sure nowt is happening when we change operation mode because the limits change.
# /// If the current value is zero +- deadband and the calibration value
# /// is defined and the ramp target is zero, then do the output.
# /// Output is the demand operation mode.
# ///
record(calcout, "$(P):CALC:LIM:CURR:ZERO") {
  field(PINI, "NO")
  field(INPA, "$(P):STS:CURRENT")
  field(INPB, "$(P):LIM:CURR:DEADBAND")
  field(INPC, "$(P):STS:CALIBRATION")
  field(OCAL, "(A<B&&C>0&E==0)?1:0")
  field(CALC, "D")
  field(INPD, "$(P):DMD:MAGMODE.VAL")
  field(INPE, "$(P):STS:RAMP:TARGET")
  field(OUT, "$(P):STS:MAGMODE PP")
  field(DOPT, "Use CALC")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Because the unit works in field or current units and some records change between them, this record
# /// calculates which limit, field or current it should enforce now and recalculates when the units mode
# /// is switched.
# ///
record(calcout, "$(P):CALC:LIM:SETPOINT:NOW") {
  field(CALC, "C==1?B:A")
  field(INPA, "$(P):LIM:CURRENT:NOW")
  field(INPB, "$(P):LIM:FIELD:NOW")
  field(INPC, "$(P):STS:UNITS")
  field(OUT, "$(P):LIM:SETPOINT PP")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Because the smc unit works in field or current units and some records change between them, this record
# /// holds the value of the limit appropriate for the current units mode.
# ///
record(ao, "$(P):LIM:SETPOINT") {
  field(OUT, "$(P):DFAN:LIM:SETPOINT PP")
}

# ///
# /// Propagation of the engineering units to the lower set point demand record when the units mode changes.
# /// Needed because we cannot DFAN a string.
# ///
record(stringout, "$(P):PROP:DMD:SETPOINT:LOWER") {
  field(DTYP, "Soft Channel")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):SET:DMD:POINT:LOWER.EGU")
  field(FLNK, "$(P):PROP:DMD:SETPOINT:UPPER")
}

# ///
# /// Propagation of the engineering units to the upper set point demand record when the units mode changes.
# /// Needed because we cannot DFAN a string.
# ///
record(stringout, "$(P):PROP:DMD:SETPOINT:UPPER") {
  field(DTYP, "Soft Channel")
  field(DOL, "$(P):STS:UNITNAME.SVAL")
  field(OMSL, "closed_loop")
  field(OUT, "$(P):SET:DMD:POINT:UPPER.EGU")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Holds the value of the upper set point demanded after limit checking has been done.
# ///
record(ai, "$(P):SET:DMD:POINT:LOWER") {
  field(FLNK, "$(P):CALC:SETPOINT:LOWER:LIMCHECK")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Holds the value of the upper set point demanded after limit checking has been done.
# ///
record(ai, "$(P):SET:DMD:POINT:UPPER") {
  field(FLNK, "$(P):CALC:SETPOINT:UPPER:LIMCHECK")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Calculation to enforce the current limit on to the lower set point and bump it down if it is too high.
# ///
record(calcout, "$(P):CALC:SETPOINT:LOWER:LIMCHECK") {
  field(DESC, "Limit check")
  field(CALC, "A<B?A:B")
  field(INPA, "$(P):SET:DMD:POINT:LOWER")
  field(INPB, "$(P):LIM:SETPOINT")
  field(OUT, "$(P):SET:POINT:LOWER PP")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Calculation to check the upper set point against the present set point limit and bump it down if it is too high.
# ///
record(calcout, "$(P):CALC:SETPOINT:UPPER:LIMCHECK") {
  field(DESC, "Limit check")
  field(CALC, "A<B?A:B")
  field(INPA, "$(P):SET:DMD:POINT:UPPER")
  field(INPB, "$(P):LIM:SETPOINT")
  field(OUT, "$(P):SET:POINT:UPPER PP")
}

record(stringin, "$(P):SCNDFLT:OPER:PARAMS") {
  field(DESC, "Default scan rate")
  field(VAL, "10 second")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Calculates the limit for this axis when in Uniaxis THIS operating mode, ie the field is along the direction
# /// controlled by the coil for which this PV is instantiated.
# ///
record(calcout, "$(P):CALC:LIMIT:UNITHIS") {
  field(CALC, "A==1?1:0")
  field(INPA, "$(P):STS:MAGMODE")
  field(INPB, "$(P):LIM:FIELD:UNIAXIS")
  field(OUT, "$(P):LIM:FIELD:NOW PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "B")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Calculates the limit for this axis when in Uniaxis OTHER operating mode, ie the field is along a direction
# /// other than the one controlled by the coil for which this PV is instantiated.
# /// The limit is zero in Uniaxis operation mode for OTHER.
# ///
record(calcout, "$(P):CALC:LIMIT:UNIOTHER") {
  field(CALC, "(A==0)?1:0")
  field(INPA, "$(P):STS:MAGMODE")
  field(OUT, "$(P):LIM:FIELD:NOW PP")
  field(DOPT, "Use OCAL")
  field(OCAL, "0")
  field(OOPT, "When Non-zero")
}

# ///
# /// Part of the implementation of limits to the field/current ramp rate in the EPICS database, external to the smc.
# /// This record controls the start up of the ramp rate limits.
# /// The initialisation of the current ramprate has to be done AFTER the calibration has been retrieved from the device.
# /// This record first runs the status command to get the calibration record updated.
# /// Then after a delay to give the unit time to respond, it triggers the ramprate limit conversion calculations.
# ///
record(seq, "$(P):INIT:LIM:RAMPRATE") {
  field(DESC, "Init ramp rate limits")
  field(PINI, "YES")
  field(DOL1, "1")
  field(DLY1, "5.0")
  field(LNK1, "$(P):GET:OPER:PARAMS.PROC PP")
  field(DLY2, "5.0")
  field(DOL2, "1")
  field(LNK2, "$(P):LIM:RAMPRATE:TPM.PROC PP")
}

# ///
# /// Part of the implementation of limits to the field/current in the EPICS database, external to the smc.
# /// Because the unit works in field or current units and some records change between them, this record
# /// propagates the current value appropriate to the current units mode to HIHI alarm fields of records affected.
# ///
record(dfanout, "$(P):DFAN:LIM:SETPOINT") {
  field(OUTA, "$(P):STS:PMCURRENT.HIHI PP")
  field(OUTB, "$(P):STS:POINT:UPPER.HIHI PP")
  field(OUTC, "$(P):STS:POINT:LOWER.HIHI PP")
}

# /// 
# /// This record is part of the implementation for the BUSY record.
# /// It holds the information as to whether the ramp target is currently being set.
# /// It helps ensure there is enough time for a round trip instruction and response after a request to change
# /// the target to be confident that the status information in the EPICS records for the BUSY calculation have
# /// been updated.
# ///
record(bi, "$(P):TARGET:SETTING") {
  field(DESC, "Ramp target being set?")
  field(FLNK, "$(P):CALC:TARGET:READY PP MS")
}

# /// 
# /// This record is part of the implementation for the BUSY record.
# /// It ensures the unit is treated as busy as soon as an instruction to change the target is sent.
# ///
record(calcout, "$(P):CALC:TARGET:INIT") {
  field(DESC, "Init ramp target setting")
  field(CALC, "1")
  field(OUT, "$(P):TARGET:SETTING PP")
}

# /// 
# /// This record is part of the implementation for the BUSY record.  
# /// It turns off the record used to gate out calculations based on old status information.
# ///
record(calcout, "$(P):CALC:TARGET:FINISH") {
  field(DESC, "Finalise ramp target setting")
  field(CALC, "0")
  field(OUT, "$(P):TARGET:SETTING PP")
}

# /// 
# /// This record is part of the implementation for the BUSY record.  
# /// It holds the resulting decision about whether the unit is ramping or not.
# /// Pausing counts as ramping.
# ///
record(bi, "$(P):TARGET:RAMPING") {
  field(DESC, "Is unit ramping?")
  field(FLNK, "$(P):CALC:TARGET:READY PP MS")
}

# /// 
# /// This record is part of the implementation for the BUSY record.  
# ///
record(calcout, "$(P):CALC:TARGET:READY") {
  field(DESC, "Is unit ready?")
  field(CALC, "(A=0&&B=0)?1:0")
  field(INPA, "$(P):TARGET:SETTING NPP MS")
  field(INPB, "$(P):TARGET:RAMPING NPP MS")
  field(OUT, "$(P):CALC:BSY:DONE.A PP")
  field(OOPT, "Transition To Non-zero")
  field(DOPT, "Use CALC")
}

# /// Busy action trigger sequence.
# /// This record controls the sequence of things that happen when a user triggers an action that
# /// makes the device busy (either set ramp target or set ramp pause).
# /// It has to introduce a delay to make sure that the status values it uses from the device
# /// come AFTER the device has had time to update the EPICS status records needed.
# /// The command to perform the triggering action on the device has already been initiated by
# /// the forwarding record SET record.
# ///
# /// First this sequence record sets the busy record to busy.
# /// Then it flips the state of the target setting record to "gate out" any status information
# /// which could be out of date.
# /// Then it initiates a status command to the device to tell it to report its status information
# /// and update the epics records.
# /// Then after a delay it flips the gating record back.
# /// The status calculations are updating independently of this sequence but should be ignored
# /// until the gate is turned off.
# ///
record(seq, "$(P):TARGET:TRIGGER") {
  field(DESC, "Busy action trig seq")
  field(DOL1, "1")
  field(LNK1, "$(P):CALC:BSY:BUSY.PROC PP MS")
  field(DOL2, "1")
  field(LNK2, "$(P):CALC:TARGET:INIT.PROC PP MS")
  field(DOL3, "1")
  field(LNK3, "$(P):GET:CURRENTSTATUS.PROC PP MS")
  field(DLY4, "6.0")
  field(DOL4, "1")
  field(LNK4, "$(P):CALC:TARGET:FINISH.PROC PP MS")
}

# ///
# /// Calculation to munge ramp state and pause state together for the purposes of the busy record.
# /// It is needed because the unit SMC reports it has made its target when the unit is paused, 
# /// which is not what is required.
# /// This record is updated every time the ramp made and ramp pause status information changes.
# ///
record(calcout, "$(P):CALC:TARGET:RAMPING") {
  field(DESC, "Calc ramping target status")
  field(CALC, "(A=0||B=1)?1:0")
  field(INPA, "$(P):STS:RAMP:MADE NPP MS")
  field(INPB, "$(P):STS:RAMP:PAUSE NPP MS")
  field(OUT, "$(P):TARGET:RAMPING PP MS")
  field(OOPT, "On Change")
}

record(fanout, "$(P):FAN:POINT") {
  field(DESC, "Lower ramp point SET")
  field(LNK1, "$(P):GET:POINTSTATUS PP MS")
  field(LNK2, "$(P):TARGET:TRIGGER PP MS")
}

# Ramp to zero target, then set the lower setpoint (the variable one) to zero
# and the upper setpoint (fixed) to the current limit.
record(sseq, "$(P):TRNSFM:LIM:CURRENT:NOW") {
  field(FLNK, "$(P):CALC:LIM:SETPOINT:NOW")
  field(DOL1, "$(P):LIM:CURRENT:NOW")
  field(LNK1, "$(P):STS:CURRENT.HIHI PP")
  field(DOL2, "0")
  field(LNK2, "$(P):SET:RAMP:TARGET CA")
  field(WAIT2, "Wait")
  field(DOL3, "0")
  field(LNK3, "$(P):SET:POINT:LOWER PP")
  field(DOL4, "$(P):LIM:FIELD:NOW")
  field(LNK4, "$(P):SET:POINT:UPPER PP")
}


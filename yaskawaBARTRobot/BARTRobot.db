# % macro, P, Device Prefix
# % macro, STREAMS_PORT, Asyn Port
# % macro, TYPE, Robot type: NX, FS, DX or YR
# % macro, COORDSYS, Coordinate system to use for displaying the robot position
# % macro, JOB1, Job 1 name
# % macro, JOB2, Job 2 name
# % macro, JOB3, Job 3 name
# % macro, JOB4, Job 4 name
# % macro, JOB5, Job 5 name
# % macro, JOB6, Job 6 name
# % macro, JOB7, Job 7 name
# % macro, JOB8, Job 8 name
# % macro, JOB9, Job 9 name
# % macro, JOB10, Job 10 name
# % macro, JOB11, Job 11 name
# % macro, JOB12, Job 12 name
# % macro, JOB13, Job 13 name
# % macro, JOB14, Job 14 name
# % macro, JOB15, Job 15 name
# % macro, JOB16, Job 16 name
# % macro, name, Object and gui association name

# Associate edm screen with template
# % gui, Yaskawa-MainAdv, edm, yaskawaBARTRobot-MainAdv.edl, robot=$(P)

record(stringin, "$(P):VER") {
  field(DTYP, "stream")
  field(INP, "@yaskawa.proto connect($(P),$(TYPE)) $(STREAMS_PORT)")
  field(PINI, "YES")
}

record(stringin, "$(P):CONNMSG") {
  field(DESC, "Connection error message")
  field(PINI, "YES")
}

record(stringin, "$(P):COORDSYS") {
  field(DESC, "Coord sys used to display robot position")
  field(VAL, "$(COORDSYS)")
  field(PINI, "YES")
}

#% archiver 1 Monitor
record(longin, "$(P):STA1") {
  field(DESC, "Robot 1st status byte")
  field(PINI, "YES")
  field(VAL, "0")
#  field(FLNK, "$(P):CHKRUN_FANOUT")
  field(FLNK, "$(P):CHKRUN")
}


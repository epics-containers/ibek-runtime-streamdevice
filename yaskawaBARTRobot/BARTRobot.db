################## Gripper Status ######################

# Forced Closed (from epics): DM020 bit 7 high
# Forced Open (from epics):   DM020 bit 7 low and DM010 bit 7 high
# Open (from robot):          DM020 bit 7 low and DM010 bit 7 low and DM006 bit 8 high
# Closed (from robot):        DM020 bit 7 low and DM010 bit 7 low and DM006 bit 8 low

record(aSub, "$(P):GET_GRIPPER_STATE")
{
  field(DESC, "3 different status bits must be checked")
  field(SNAM, "GripperState")
  field(INPA, "$(P):STATUS_BITS_020.B7 CP")
  field(INPB, "$(P):STATUS_BITS_010.B7 CP")
  field(INPC, "$(P):STATUS_BITS_006.B8 CP")
  field(FTA,  "SHORT")
  field(FTB,  "SHORT")
  field(FTC,  "SHORT")
  field(FTVA, "CHAR")
  field(NOVA, "40")
  field(OUTA, "$(P):GRIPPER_STATE PP")
}

#% archiver 1 Monitor
record(waveform, "$(P):GRIPPER_STATE")
{
  field(DESC, "Forced closed/open or controlled by robo")
  field(NELM, "40")
  field(FTVL, "CHAR")
}

# % macro, P, Device Prefix
# % macro, STREAMS_PORT, Asyn Port
# % macro, VAR, Long integer (int32) just for reading from robot controller.  D Variable (e.g. D001) as Yaskawa refers to these as double precision variables.
# % macro, SCAN, Scan rate
# % macro, DESC, Variable's description


#% archiver 1 Monitor
record(ai, "$(P):D$(CUR_COLUMN_VAR_NUM)_RBV") {
    field(DESC, "Current Carrier Column")
    field(DISP, "1")
    field(DTYP, "stream")
    field(INP, "@yaskawa.proto readd($(P),$(CUR_COLUMN_VAR_NUM)) $(STREAMS_PORT,undefined)")
    field(PREC, "0")
    field(SCAN, "1 second")
}

# % macro, P, Device Prefix
# % macro, STREAMS_PORT, Asyn Port
# % macro, VAR, Long integer (int32) just for reading from robot controller.  D Variable (e.g. D001) as Yaskawa refers to these as double precision variables.
# % macro, SCAN, Scan rate
# % macro, DESC, Variable's description


#% archiver 1 Monitor
record(ai, "$(P):D$(CUR_ROW_VAR_NUM)_RBV") {
    field(DESC, "Current Carrier Row")
    field(DISP, "1")
    field(DTYP, "stream")
    field(INP, "@yaskawa.proto readd($(P),$(CUR_ROW_VAR_NUM)) $(STREAMS_PORT,undefined)")
    field(PREC, "0")
    field(SCAN, "1 second")
}

# % macro, P, Device Prefix
# % macro, STREAMS_PORT, Asyn Port
# % macro, VAR, Long integer (int32) just for reading from robot controller.  D Variable (e.g. D001) as Yaskawa refers to these as double precision variables.
# % macro, SCAN, Scan rate
# % macro, DESC, Variable's description


#% archiver 1 Monitor
record(ai, "$(P):D$(CUR_SLOT_VAR_NUM)_RBV") {
    field(DESC, "Current Slot within Carrier")
    field(DISP, "1")
    field(DTYP, "stream")
    field(INP, "@yaskawa.proto readd($(P),$(CUR_SLOT_VAR_NUM)) $(STREAMS_PORT,undefined)")
    field(PREC, "0")
    field(SCAN, "1 second")
}

# % macro, P, Device Prefix
# % macro, STREAMS_PORT, Asyn Port
# % macro, VAR, Long integer (int32) to read/write but without sync of target value to RBV.  D Variable (e.g. D001) as Yaskawa refers to these as double precision variables.
# % macro, DISWRITE, When the given PV is equal to DISV this variable cannot be written to.  Default can't just be set to the prefix otherwise record will not be processed.  STA2=64 is used as this prevents this variable being changed when the robot servo is on.
# % macro, DISV, Value that DISWRITE PV is compared to
# % macro, SCAN, Scan rate
# % macro, DRVL, Low limit
# % macro, DRVH, High limit
# % macro, DESC, Variable's description


# See above for SDIS and DISV defaults.
#% archiver 1 Monitor
record(ao, "$(P):D$(NEXT_COLUMN_VAR_NUM)") {
    field(DESC, "Next Carrier Column")
    field(SDIS, "$(P):$(DISWRITE)")
    field(DISV, "$(DISV)")
    field(OUT, "$(P):D$(NEXT_COLUMN_VAR_NUM):WRITE PP")
    field(PREC, "0")
}

record(ao, "$(P):D$(NEXT_COLUMN_VAR_NUM):WRITE") {
    field(DESC, "Next Carrier Column")
    field(DTYP, "stream")
    field(OUT, "@yaskawa.proto writed($(P),$(NEXT_COLUMN_VAR_NUM)) $(STREAMS_PORT,undefined)")
    field(PREC, "0")
    field(DRVL, "1")
    field(DRVH, "7")
}

#% archiver 1 Monitor
record(ai, "$(P):D$(NEXT_COLUMN_VAR_NUM)_RBV") {
    field(DESC, "Next Carrier Column")
    field(DISP, "1")
    field(DTYP, "stream")
    field(INP, "@yaskawa.proto readd($(P),$(NEXT_COLUMN_VAR_NUM)) $(STREAMS_PORT,undefined)")
    field(PREC, "0")
    field(SCAN, "1 second")
}


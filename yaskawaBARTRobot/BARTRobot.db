# JOBTGT contains all robot jobs set in an ioc.  Names can be up to 32
# characters and must exactly match the job names on the robot controller.
# 
# A job called NOP (no operation) that doesn't move the robot is often programmed for
# testing.  This is good default to use for JOBTGT.JOB1, especially since jobs are
# automatically run, as soon as JOBTGT is processed, if AUTO_RUN_JOBS is set (see below).
#
# ----------------------------------
# ***** Do not set PINI to YES *****
# ----------------------------------
# Do not set PINI to YES as this could lead to JOB1 being run when the ioc is started.
# AUTO_RUN_JOBS below is autosaved so could already be set true - see AUTO_RUN_JOBS comments.
# ----------------------------------
#
#% archiver 1 Monitor
record(mbbi, "$(P):JOBTGT") {
  #################
  # Must not be processed on initialisation - see above.
  field(PINI, "NO")
  #################
  field(DESC, "Robot Job Selection")
  field(SDIS, "$(P):RUNNING")
  field(ZRST, "$(JOB1)")
  field(ONST, "$(JOB2)")
  field(TWST, "$(JOB3)")
  field(THST, "$(JOB4)")
  field(FRST, "$(JOB5)")
  field(FVST, "$(JOB6)")
  field(SXST, "$(JOB7)")
  field(SVST, "$(JOB8)")
  field(EIST, "$(JOB9)")
  field(NIST, "$(JOB10)")
  field(TEST, "$(JOB11)")
  field(ELST, "$(JOB12)")
  field(TVST, "$(JOB13)")
  field(TTST, "$(JOB14)")
  field(FTST, "$(JOB15)")
  field(FFST, "$(JOB16)")
#  field(FLNK, "$(P):JOBTGTLEN PP")
  field(FLNK, "$(P):JOBSEL_FANOUT PP")
}

# Sets GDA_JOB_RUNNING as well as calling JOBTGTLEN
record(fanout, "$(P):JOBSEL_FANOUT") {
  field(LNK1, "$(P):JOBTGTLEN")
  field(LNK2, "$(P):SET_GDA_JOB_RUN")
}

# Sets GDA_JOB_RUNNING true as soon as a job is selected
# unless AUTO_RUN_JOBS is false
record(ao, "$(P):SET_GDA_JOB_RUN") {
  field(DESC, "Set as soon as job selected")
  field(VAL,  "1")
  field(OUT,  "$(P):GDA_JOB_RUNNING PP")
  field(SDIS, "$(P):AUTO_RUN_JOBS")
  field(DISV, "0")
}

# Sets GDA_JOB_RUNNING true as soon as a job is started
# unless AUTO_RUN_JOBS is true
record(ao, "$(P):SET_GDA_JOB_RUN2") {
  field(DESC, "Set as soon as job selected")
  field(VAL,  "1")
  field(OUT,  "$(P):GDA_JOB_RUNNING PP")
  field(SDIS, "$(P):AUTO_RUN_JOBS")
  field(DISV, "1")
}

# Used by GDA to check when a job has been started
#% archiver 1 Monitor
record(busy, "$(P):GDA_JOB_RUNNING") {
  field(DESC, "Used by GDA to check when job started")
  field(VAL,  "0")
  field(PINI, "YES")
}

# Resets GDA_JOB_RUNNING when job stops (as determined by CHKRUN)
record(calcout, "$(P):CHKRUN2") {
  field(DESC, "Resets GDA_JOB_RUNNING when job stops")
  field(OUT,  "$(P):GDA_JOB_RUNNING CA")
  field(CALC, "A")
  field(INPA, "$(P):RUNNING NPP")
  field(OOPT, "Transition To Zero")
  field(DOPT, "Use CALC")
}


# Robot job names can be up to 32 characters.  When any command data needs to be
# sent to the robot the number of characters + 1 (for LF) must be given after
# the command, e.g. out "HOSTCTRL_REQUEST START 16" if the jobname that will
# follow in the next out, e.g. out "<jobname>", is 15 characters.
record(scalcout, "$(P):JOBTGTLEN") {
  field(DESC, "Number of characters in JOBTGT + 1")
  field(INAA, "$(P):JOBTGT PP")
  field(CALC, "LEN(AA)+1")
  field(FLNK, "$(P):RUN_JOB_NOW PP")
}

# Two methods of running jobs:
# 1) Selecting JOBTGT and pressing START.  All jobs set in an ioc can be run from
#    the support module screen using this method.
# 2) Setting JOBTGT using a Message Button.  If the below AUTO_RUN_JOBS is true,
#    START is called automatically when JOBTGT is set.  (If a job is already
#    running the START record is disabled.)
#    AUTO_RUN_JOBS is autosaved so it can be set on the yaskawaBARTRobot-MainAdv.edl
#    when the robot is setup.  Subsequently the jobs that "users" are allowed
#    to run can be limited to the message buttons on the normal BL screen, with the
#    advanced screen being password protected.  As edm related display buttons
#    cannot be password protected a visibility PV, ADV_SCREEN_VIS, has been added.
#    (This is used in yaskawaBARTRobot-MainUser.edl in yaskawaBARTRobot.)
#% archiver 1 Monitor
#% autosave 1 VAL
record(ai, "$(P):AUTO_RUN_JOBS") {
  field(DESC, "If false START required to man run job")
  field(SDIS, "$(P):RUNNING")
}

record(ao, "$(P):RUN_JOB_NOW") {
  field(DESC, "If AUTO_RUN_JOBS true start JOBTGT")
  field(SDIS, "$(P):AUTO_RUN_JOBS")
  field(DISV, "0")
  field(FLNK, "$(P):START")
}

# Can be used to hide Yaskawa-MainAdv screen from users - see AUTO_RUN_JOBS.
#% archiver 1 Monitor
record(ai, "$(P):ADV_SCREEN_VIS") {
  field(DESC, "Prevents users opening adv ctrl screen")
}

# The robot START command must never be sent without a job name.  If it is the
# robot will continue the last job from the last line number.  As the command data
# length must be set correctly this may not to do anything but is best avoided.
#
# Disabled when a job is already running.
#
#% archiver 1 Monitor
record(ao, "$(P):START") {
  field(FLNK, "$(P):START_FANOUT")
  field(SDIS, "$(P):GDA_JOB_RUNNING")
}

# Sets GDA_JOB_RUNNING as well as calling CLCOUNT
record(fanout, "$(P):START_FANOUT") {
  field(LNK1, "$(P):CLCOUNT")
  field(LNK2, "$(P):SET_GDA_JOB_RUN2")
}

record(ao, "$(P):CLCOUNT") {
  field(DESC, "Clears the job timer")
  field(VAL, "0")
  field(FLNK, "$(P):STARTSIG")
  field(OUT, "$(P):COUNTER PP")
}

record(ao, "$(P):STARTSIG") {
  field(DESC, "Start Robot")
  field(DTYP, "stream")
  field(OUT, "@yaskawa.proto start($(P)) $(STREAMS_PORT)")
  field(FLNK, "$(P):SETRUNNING")
}

record(ao, "$(P):SETRUNNING") {
  field(VAL, "1")
  field(OUT, "$(P):RUNNING PP")
  field(FLNK, "$(P):CLEAR_CMD_ERR")
}

#% archiver 1 Monitor
record(ao, "$(P):COUNTER") {
  field(DESC, "Time robot running for")
  field(VAL, "0")
  field(PINI, "YES")
  field(HIGH, "30")
  field(HSV, "MINOR")
}

record(calcout, "$(P):COUNTERCALC") {
  field(OUT, "$(P):COUNTER PP")
  field(CALC, "A+1")
  field(INPA, "$(P):COUNTER.VAL NPP")
  field(SCAN, "1 second")
  field(SDIS, "$(P):RUNNING")
  field(DISV, "0")
}

record(calcout, "$(P):CHKRUN") {
  field(OUT, "$(P):RUNNING.VAL CA")
  field(CALC, "((A&8)=8)|B<2?1:0")
  field(INPA, "$(P):STA1.VAL NPP")
  field(INPB, "$(P):COUNTER.VAL NPP")
  field(OOPT, "When Zero")
  field(DOPT, "Use CALC")
  field(FLNK, "$(P):CHKRUN2")
}

#% archiver 1 Monitor
record(busy, "$(P):RUNNING") {
  field(VAL, "0")
  field(PINI, "YES")
}

#% archiver 1 Monitor
record(bo, "$(P):SVON") {
  field(DESC, "Switches the servo on")
  field(DTYP, "stream")
  field(OUT, "@yaskawa.proto svon($(P)) $(STREAMS_PORT)")
  field(VAL, "0")
}

#% archiver 1 Monitor
record(bo, "$(P):SVOFF") {
  field(DESC, "Switches the servo off")
  field(DTYP, "stream")
  field(OUT, "@yaskawa.proto svoff($(P)) $(STREAMS_PORT)")
  field(VAL, "0")
}

#% archiver 1 Monitor
record(bo, "$(P):HOLDON") {
  field(DESC, "Hold/Stop Robot")
  field(DTYP, "stream")
  field(OUT, "@yaskawa.proto holdon($(P)) $(STREAMS_PORT)")
  field(VAL, "0")
}

#% archiver 1 Monitor
record(bo, "$(P):HOLDOFF") {
  field(DESC, "Release Hold")
  field(DTYP, "stream")
  field(OUT, "@yaskawa.proto holdoff($(P)) $(STREAMS_PORT)")
  field(VAL, "0")
}

record(stringin, "$(P):STATUS") {
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@yaskawa.proto status($(P)) $(STREAMS_PORT)")
}

record(stringin, "$(P):JOBCURMON") {
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@yaskawa.proto jobcur($(P)) $(STREAMS_PORT)")
}

#% archiver 1 Monitor
record(calcout, "$(P):RECONNECTS") {
  field(SCAN, "10 second")
  field(SDIS, "$(P):STATUS.SEVR")
  field(DISV, "0")
# Disables when connection is ok
  field(FLNK, "$(P):VER")
  field(VAL, "0")
  field(CALC, "A+1")
  field(INPA, "$(P):RECONNECTS")
  field(OUT, "$(P):RECONNECTS")
}

#% archiver 1 Monitor
record(longin, "$(P):ERR") {
  field(DESC, "Error Number")
  field(PINI, "YES")
}

#% archiver 1 Monitor
record(stringin, "$(P):ERRCMD") {
  field(DESC, "Error Command")
  field(PINI, "YES")
}

record(longout, "$(P):CLEAR_CMD_ERR") {
  field(DESC, "Clear Error Number")
  field(VAL,  0)
  field(OUT,  "$(P):ERR")
  field(FLNK, "$(P):ERR")
}

record(calcout, "$(P):REINIT") {
  field(INPA, "$(P):ERR CP")
  field(CALC, "A==1010")
  field(OUT, "$(P):VER.PROC PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use CALC")
}

#% archiver 1 Monitor
record(stringin, "$(P):JOBCUR") {
  field(DESC, "Current job name")
}

record(longin, "$(P):JOBCURLINE") {
  field(DESC, "Current job line number")
}

record(longin, "$(P):JOBCURSTEP") {
  field(DESC, "Current job step number")
}

record(stringout, "$(P):TESTSTROUT") {
  field(DESC, "Can be used to send a test command")
}

record(stringin, "$(P):TESTSTRIN") {
  field(DTYP, "stream")
  field(INP, "@yaskawa.proto sendTestString($(P)) $(STREAMS_PORT)")
}


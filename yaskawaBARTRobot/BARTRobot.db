#  field(FLNK, "$(P):GET_BARCODE PP")
#}

# Record takes in 5 barcode data words
# (Each word can hold 2 ASCII characters of the
# barcode string) and returns a string of the
# complete barcode.
record(aSub, "$(P):GET_BARCODE")
{
  field(DESC, "Translate words to barcode")
  field(SNAM, "DecToAsc")
  field(INPA, "$(P):BARCODE_WORD_0")
  field(INPB, "$(P):BARCODE_WORD_1")
  field(INPC, "$(P):BARCODE_WORD_2")
  field(INPD, "$(P):BARCODE_WORD_3")
  field(INPE, "$(P):BARCODE_WORD_4")
  field(FTA,  "LONG")
  field(FTB,  "LONG")
  field(FTC,  "LONG")
  field(FTD,  "LONG")
  field(FTE,  "LONG")
  field(FTVA, "STRING")
  field(OUTA, "$(P):BARCODE PP")
}

# Display the translated barcode string
#% archiver 1 Monitor
record(waveform, "$(P):BARCODE")
{
  field(DESC, "Barcode Result")
  field(NELM, "5")
  field(FTVL, "STRING")
}

# Clear the barcode upon starting a Load
record(stringout, "$(P):CLEAR_BARCODE")
{
  field(DESC, "Clear the Barcode")
  field(VAL,  "")
  field(OUT,  "$(P):BARCODE PP")
}



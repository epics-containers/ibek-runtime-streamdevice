#################################################

# Template to hold the individual words of barcode data.
# 5 words are read in total, each can contain 2 barcode characters.
# Once all 5 are collected, they are glued together and translated as a string.

record(subArray, "$(P):BARCODE_WORD_0:GET")
{
  field(DESC, "Get word 0")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM5XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "70")
}

record(ai, "$(P):BARCODE_WORD_0")
{
  field(DESC, "Word 0 of Barcode")
  field(INP,  "$(P):BARCODE_WORD_0:GET CP MS")
  field(PREC, "0")
  field(MDEL, "-1")
}

# Template to hold the individual words of barcode data.
# 5 words are read in total, each can contain 2 barcode characters.
# Once all 5 are collected, they are glued together and translated as a string.

record(subArray, "$(P):BARCODE_WORD_1:GET")
{
  field(DESC, "Get word 1")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM5XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "71")
}

record(ai, "$(P):BARCODE_WORD_1")
{
  field(DESC, "Word 1 of Barcode")
  field(INP,  "$(P):BARCODE_WORD_1:GET CP MS")
  field(PREC, "0")
  field(MDEL, "-1")
}

# Template to hold the individual words of barcode data.
# 5 words are read in total, each can contain 2 barcode characters.
# Once all 5 are collected, they are glued together and translated as a string.

record(subArray, "$(P):BARCODE_WORD_2:GET")
{
  field(DESC, "Get word 2")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM5XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "72")
}

record(ai, "$(P):BARCODE_WORD_2")
{
  field(DESC, "Word 2 of Barcode")
  field(INP,  "$(P):BARCODE_WORD_2:GET CP MS")
  field(PREC, "0")
  field(MDEL, "-1")
}

# Template to hold the individual words of barcode data.
# 5 words are read in total, each can contain 2 barcode characters.
# Once all 5 are collected, they are glued together and translated as a string.

record(subArray, "$(P):BARCODE_WORD_3:GET")
{
  field(DESC, "Get word 3")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM5XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "73")
}

record(ai, "$(P):BARCODE_WORD_3")
{
  field(DESC, "Word 3 of Barcode")
  field(INP,  "$(P):BARCODE_WORD_3:GET CP MS")
  field(PREC, "0")
  field(MDEL, "-1")
}

# Template to hold the individual words of barcode data.
# 5 words are read in total, each can contain 2 barcode characters.
# Once all 5 are collected, they are glued together and translated as a string.

record(subArray, "$(P):BARCODE_WORD_4:GET")
{
  field(DESC, "Get word 4")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM5XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "74")
}

record(ai, "$(P):BARCODE_WORD_4")
{
  field(DESC, "Word 4 of Barcode")
  field(INP,  "$(P):BARCODE_WORD_4:GET CP MS")
  field(PREC, "0")
  field(MDEL, "-1")
}

# Associate edm screen with template (lots of macros required)
# % gui, Yaskawa-MainUser, edm, yaskawaBARTRobot-MainUser.edl, P=$(P), CUR_COLUMN_VAR_NUM=$(CUR_COLUMN_VAR_NUM), CUR_ROW_VAR_NUM=$(CUR_ROW_VAR_NUM), CUR_SLOT_VAR_NUM=$(CUR_SLOT_VAR_NUM), NEXT_COLUMN_VAR_NUM=$(NEXT_COLUMN_VAR_NUM), NEXT_ROW_VAR_NUM=$(NEXT_ROW_VAR_NUM), NEXT_SLOT_VAR_NUM=$(NEXT_SLOT_VAR_NUM,undefined)


#######################################################

record(asyn,"$(P):ASYN_RECORD")
{
  field(DESC, "Robot Comms Asyn Record")
  field(DTYP, "asynRecordDevice")
  field(PORT, "$(PORT)")
  field(ADDR, "0")
  field(OMAX, "255")
  field(IMAX, "255")
}

################## Misc PLC Status Words ##############

record(subArray, "$(P):STATUS_WORD_006")
{
  field(DESC, "Gripper and Geobrick GPInputs word")
  field(DTYP, "Soft Channel")
  field(FTVL, "SHORT")
  field(INP,  "$(P):DM0XX CP MS")
  field(MALM, "100")
  field(NELM, "1")
  field(INDX, "6")
}

#% archiver 1 Monitor
record(mbbiDirect, "$(P):STATUS_BITS_006")
{
  field(DESC, "Gripper and Geobrick GPInputs bits")
  field(DTYP, "Soft Channel")
  field(INP,  "$(P):STATUS_WORD_006 CP")
}


# %gdatag,template,simplePv,$(gda_name=).CH$(N)SETPOINT,$(gda_desc=) channel $(N) brightness setpoint
# %gdatag,template,simplePv,$(gda_name=).CH$(N)READBACK,$(gda_desc=) channel $(N) brightness readback
# %gdatag,template,simpleBinary,$(gda_name=).CH$(N)SWITCH,$(gda_desc=) channel $(N) on/off switch
# %gdatag,pv,rw,$(gda_name=).CH$(N)SETPOINT,RECORD,Brightness setpoint
record(ai, "$(P):CH$(N)SETOUTPUT") {
  field(DESC, "Set current output")
  field(FLNK, "$(P):CH$(N)CAPOUTPUT")
  field(VAL, "0")
  field(PREC, "2")
  field(EGU, "mA")
  field(LOPR, "0")
  field(HHSV, "MAJOR")
  field(LLSV, "MAJOR")
}

# Only continuous mode is supported
record(stringout, "$(P):CH$(N)SETMODE") {
  field(DESC, "Set output mode")
  field(DTYP, "stream")
  field(OUT, "@gardasoft.protocol setMode($(N)) $(PORT)")
  field(PINI, "YES")
  field(PRIO, "HIGH")
  field(VAL, "0")
}

# Only continuous mode is supported
record(mbbi, "$(P):CH$(N)MODE") {
  field(DESC, "Output mode")
  field(ZRST, "Continuous")
  field(ONST, "Trigger on 1")
  field(TWST, "Trigger on 2")
  field(THST, "Trigger on both")
  field(FRST, "Select on 1")
  field(FVST, "Select on 2")
  field(SXST, "Select on both")
}

record(ai, "$(P):CH$(N)MAXCURRENT") {
  field(DESC, "Max current rating")
  field(PREC, "2")
  field(EGU, "mA")
}

# %gdatag,binary,rw,$(gda_name=).CH$(N)SWITCH,RECORD,On/Off switch
record(bo, "$(P):CH$(N)ON") {
  field(DESC, "Turns LED On/Off")
  field(FLNK, "$(P):CH$(N)SENDOUTPUT")
  field(ZNAM, "LED OFF")
  field(ONAM, "LED ON")
  field(ZSV, "MAJOR")
}

# Outputs '0' to switch off
record(calcout, "$(P):CH$(N)SENDOUTPUT") {
  field(DESC, "Sends desired current output")
  field(DTYP, "stream")
  field(CALC, "B?A:B")
  field(INPA, "$(P):CH$(N)SETOUTPUT")
  field(INPB, "$(P):CH$(N)ON")
  field(OUT, "@gardasoft.protocol setOutput($(N),$(P)) $(PORT)")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
  field(FLNK, "$(P):QUERYSETTINGS PP")
}

record(ao, "$(P):CH$(N)SETMAXCURRENT") {
  field(DESC, "Set max current rating")
  field(FLNK, "$(P):CH$(N)CAPOUTPUT")
  field(OUT, "$(P):CH$(N)LIMITS PP")
  field(EGU, "mA")
}

record(calcout, "$(P):CH$(N)CAPOUTPUT") {
  field(DESC, "Cap output to max rating")
  field(FLNK, "$(P):CH$(N)SENDOUTPUT")
  field(CALC, "B>A")
  field(INPA, "$(P):CH$(N)SETMAXCURRENT")
  field(INPB, "$(P):CH$(N)SETOUTPUT")
  field(OUT, "$(P):CH$(N)SETOUTPUT")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
}

record(dfanout, "$(P):CH$(N)LIMITS") {
  field(DESC, "Forwards max current limit")
  field(OUTA, "$(P):CH$(N)SETOUTPUT.HOPR")
  field(OUTB, "$(P):CH$(N)SETOUTPUT.HIHI")
  field(DOL, "$(P):CH$(N)LIMITS")
}

# Initialises 'set' records with readback from controller. Runs once 10 seconds
# after the IOC has booted.
record(seq, "$(P):CH$(N)INIT") {
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(SELM, "All")
  field(DLY1, "10")
  field(DOL1, "$(P):CH$(N)MAXCURRENT")
  field(LNK1, "$(P):CH$(N)SETMAXCURRENT")
  field(DOL2, "$(P):CH$(N)BRIGHTNESS.VAL")
  field(LNK2, "$(P):CH$(N)SETOUTPUT")
  field(FLNK, "$(P):ONOFFCHECK")
  field(DOL3, "$(P):CH$(N)SETMAXCURRENT")
  field(LNK3, "$(P):CH$(N)LIMITS PP")
}

# Checks if the output current is greater than zero in order to correctly set the
# status of the on/off switch.
record(calcout, "$(P):ONOFFCHECK") {
  field(CALC, "A>0")
  field(INPA, "$(P):CH$(N)BRIGHTNESS.VAL")
  field(OUT, "$(P):CH$(N)ON PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# %gdatag,pv,ro,$(gda_name=).CH$(N)READBACK,RECORD,Brightness readback
record(ai, "$(P):CH$(N)BRIGHTNESS") {
  field(DESC, "Output current")
  field(PREC, "2")
  field(EGU, "mA")
}

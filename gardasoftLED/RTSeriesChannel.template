  field(CALC, "(A)? (1<<1)|B : ~((1<<1))&B")
  field(INPA, "$(P):CH$(N):OPTIONS:SET-01.VAL")
  field(INPB, "$(P):CH$(N):OPTIONS CA")
  field(OUT, "$(P):CH$(N):SETOPTIONS PP")
  field(OOPT, "Every Time")
}


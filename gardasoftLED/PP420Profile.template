# One instance created for each profile. Currently supports 6 profiles.
# A profile stores a snapshot of user-defined settings that are autosaved and can be re-loaded to the device.

# % macro, P, Domain
# % macro, PROFILE, Profile number 1-6
# % macro, LINKPOS, EPICS link prefix, use ZR = profile 1, ON = profile 2, TW = profile 3, TH = profile 4, FR = profile 5, FV = profile 6

#% autosave 1 VAL
record(stringout, "$(P):PR$(PROFILE):NAME") {
  field(DESC, "Profile $(PROFILE) Name")
  field(PINI, "YES")
}

record(stringin, "$(P):PR$(PROFILE):DEFAULT_LABEL") {
  field(DESC, "Default Menu Label for GUI")
  field(VAL, "Profile $(PROFILE)")
}

record(scalcout, "$(P):PR$(PROFILE):SET_LABEL") {
  field(DESC, "Set Label to Name if Not Empty")
  field(CALC, "LEN(AA)>0 ? AA : BB")
  field(INAA, "$(P):PR$(PROFILE):NAME CP")
  field(INBB, "$(P):PR$(PROFILE):DEFAULT_LABEL PP")
  field(OUT, "$(P):PROFILE_TO_LOAD_SEL.$(LINKPOS)ST NPP")
}

# Links are setup by individual channel
record(fanout, "$(P):PR$(PROFILE):LOAD") {
  field(DESC, "Load Profile $(PROFILE) Settings")
  field(LNK1, "$(P):PR$(PROFILE):CH1:LOAD")
  field(LNK2, "$(P):PR$(PROFILE):CH2:LOAD")
  field(LNK3, "$(P):PR$(PROFILE):CH3:LOAD")
  field(LNK4, "$(P):PR$(PROFILE):CH4:LOAD")
  field(LNK5, "$(P):PR$(PROFILE):MODE:LOAD")
}

# Links are setup by individual channel
record(fanout, "$(P):PR$(PROFILE):RESET") {
  field(DESC, "Load Profile $(PROFILE) Settings")
  field(LNK1, "$(P):PR$(PROFILE):CH1:RESET")
  field(LNK2, "$(P):PR$(PROFILE):CH2:RESET")
  field(LNK3, "$(P):PR$(PROFILE):CH3:RESET")
  field(LNK4, "$(P):PR$(PROFILE):CH4:RESET")
  field(LNK5, "$(P):PR$(PROFILE):NAME:RESET")
  field(LNK6, "$(P):PR$(PROFILE):MODE:RES")
}

record(stringout, "$(P):PR$(PROFILE):NAME:RESET") {
  field(OUT, "$(P):PR$(PROFILE):NAME PP")
}

#% autosave 1 VAL
record(mbbo, "$(P):PR$(PROFILE):MODE") {
  field(DESC, "Profile $(PROFILE) Mode")
  field(ZRVL, "1")
  field(ONVL, "2")
  field(TWVL, "3")
  field(ZRST, "Continuous")
  field(ONST, "Pulsed")
  field(TWST, "Switched")
  field(VAL, "0")
  field(PINI, "YES")
}

record(longout, "$(P):PR$(PROFILE):MODE:RES") {
  field(DESC, "Reset Profile $(PROFILE) Mode")
  field(VAL, "0")
  field(OUT, "$(P):PR$(PROFILE):MODE.VAL PP")
}

record(dfanout, "$(P):PR$(PROFILE):MODE:LOAD") {
  field(DESC, "Load Profile $(PROFILE) Mode")
  field(OUTA, "$(P):MODE PP")
  field(DOL, "$(P):PR$(PROFILE):MODE.VAL")
  field(OMSL, "closed_loop")
}

record(calcout, "$(P):PR$(PROFILE):TRIGGER_DISABLE")
{
  field(DESC, "Disable Profile $(PROFILE) Trigger Features")
  field(INPA, "$(P):PR$(PROFILE):MODE CP")
  field(CALC, "A==0")
}

record(calcout, "$(P):PR$(PROFILE):PULSE_DISABLE")
{
  field(DESC, "Disable Profile $(PROFILE) Pulse Features")
  field(INPA, "$(P):PR$(PROFILE):MODE CP")
  field(CALC, "A!=1")
}

# Protocol file for the Gardasoft Vision RT series LED lighting controllers (tested on the PP820)
# Version: 1.0
# Date:    02-05-2026

# Please refer to the Gardasoft Vision User Manual - PP8xx LED Controller Version 020

OutTerminator = CR;
InTerminator = LF CR ">";
replytimeout = 100;
readtimeout  = 2000;


status { 
        out "ST\$2"; 
        in "ST\$2\n\rCH %(\$1:CH\$2:NUMBER_RBV)d M %(\$1:CH\$2:MODE_RBV)d V %(\$1:CH\$2:MAX_CURRENT_RBV)fA"; 
        @mismatch { in " D %(\$1:CH\$2:DELAY_RBV)fus P %(\$1:CH\$2:WIDTH_RBV)fus R %(\$1:CH\$2:RETRIGGER_RBV)fus"};
}

# Report the firmware version
# $1 - PV prefix
getVersion { 
	out "VR"; 
	in "VR%(\$1:MODEL_RBV)s %(\$1:HW_VERSION_RBV)s %(\$1:FW_VERSION_RBV)s"; 
}

# Save settings to the controller's
# non-volatile memory
save {
	out "AW";
	in "AW";
}

# Read any error messages. 
readErrors {
	out "GR";
	in "%s";
}

#Set trigger mode
#$1 - mode:
#	 0 channels triggerd individually
#        1 all channels tirggerd by inupt 0
#        2 channels 0-3 triggerd form inupt 0 channes 4-7 triggerd form input 4
# Note when all channes being triggered from input 0, the other triggers shoudl not be pulsed
# $2 - pv prefix
setTriggerMode  {
        out "FP%(\$1:\$2)d";
        in "FP%(\$1:TRIGGER_MODE_RBV)d";
}

# This command enables or disables the internal trigger. When
# enabled, all outputs are triggered simultaneously using an internal
# trigger signal. 
setInternalTrigger { 
        out "TT%(\$1:\$2)d,%(\$1:\$3)d"; 
        in "TT%(\$1:TRIG_STATE_RBV)d,%(\$1:PERIOD_RBV)d";
}

# Clear all output channel settings. All output channel and timer
# settings are cleared to a default value 0.0A continuous
clear {
        out "CL";
        in "CL";
}

# Simulate an input trigger
# $2 - chanel number
fireTrigger {
        out "TR\$2"; 
        in "TR\$2";
}

# This command sets the specified channel to continuous operation at 
# the required current.
# $1 - pv prefix
# $2 - chanel number
setContinuousMode {
        out "RS\$2,%(\$1:CH\$2:MAX_CURRENT)f";        
        #in "RS%(\$1:CH\$2:NUMBER_RBV)d,%(\$1:CH\$2:MAX_CURRENT_RBV)f";
        in "RS\$2,%f";
}

# This command sets the specified channel to switched mode at the 
# required current.
# $1 - pv prefix
# $2 - chanel number
setSwitchedMode {
        out "RW\$2,%(\$1:CH\$2:MAX_CURRENT)f";
        #in "RW%(\$1:CH\$2:NUMBER_RBV)d,%(\$1:CH\$2:MAX_CURRENT_RBV)f";
        in "RW\$2,%f";
}

# This command sets the pulse parameters for the specified channel.
# Note:
# Output 1 can only be triggered by input 1, and output 2 can 
# only be triggered by output 2, and so on.
# The pulse delay can be from approximately 3μs to 1 second. The 
# pulse width can be any value from 1μs to 1 second.
# $1 - pv prefix
# $2 - chanel number
setPulsedMode {
        out "RT\$2,%(\$1:CH\$2:WIDTH)f,%(\$1:CH\$2:DELAY)f,%(\$1:CH\$2:MAX_CURRENT)f,%(\$1:CH\$2:RETRIGGER)f";
        in "RT%(\$1:CH\$2:NUMBER_RBV)d,%(\$1:CH\$2:WIDTH_RBV)f,%(\$1:CH\$2:DELAY_RBV)f,%(\$1:CH\$2:MAX_CURRENT_RBV)f,%(\$1:CH\$2:RETRIGGER_RBV)f";
}



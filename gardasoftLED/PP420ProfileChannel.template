# One instance created for each channel of each profile.

# % macro, P, Domain
# % macro, PROFILE, Profile number 1-6
# % macro, CHANNEL, Channel number 1-4

###################  Brightness ###################
record(ao, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHT:RES") {
  field(DESC, "Reset Profile $(PROFILE) Ch$(CHANNEL) Brightness")
  field(VAL, "0")
  field(OUT, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHTNESS PP")
}

#% autosave 1 VAL
record(ao, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHTNESS") {
  field(DESC, "Profile $(PROFILE) Ch$(CHANNEL) Brightness")
  field(PINI, "YES")
  field(VAL, "0")
  field(DRVH, "100")
  field(DRVL, "0")
}

record(dfanout, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHT:LOAD") {
  field(DESC, "Load Profile $(PROFILE) Ch$(CHANNEL) Brightness")
  field(OUTA, "$(P):CH$(CHANNEL):BRIGHTNESS_DO PP")
  field(DOL, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHTNESS")
  field(OMSL, "closed_loop")
}


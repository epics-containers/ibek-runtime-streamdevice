################### Setup links for this channel ###################
record(fanout, "$(P):PR$(PROFILE):CH$(CHANNEL):RESET") {
  field(LNK1, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHT:RES")
  field(LNK2, "$(P):PR$(PROFILE):CH$(CHANNEL):DELAY:RES")
  field(LNK3, "$(P):PR$(PROFILE):CH$(CHANNEL):WIDTH:RES")
  field(LNK4, "$(P):PR$(PROFILE):CH$(CHANNEL):TRIG_EDGE:RES")
  field(LNK5, "$(P):PR$(PROFILE):CH$(CHANNEL):TRIG_INPUT:RES")
}

record(fanout, "$(P):PR$(PROFILE):CH$(CHANNEL):LOAD") {
  field(DESC, "Load Profile $(PROFILE) Ch$(CHANNEL) Settings")
  field(LNK1, "$(P):PR$(PROFILE):CH$(CHANNEL):BRIGHT:LOAD")
  field(LNK2, "$(P):PR$(PROFILE):CH$(CHANNEL):DELAY:LOAD")
  field(LNK3, "$(P):PR$(PROFILE):CH$(CHANNEL):WIDTH:LOAD")
  field(LNK4, "$(P):PR$(PROFILE):CH$(CHANNEL):TRIG_EDGE:LOAD")

# Send query to the controller
record(ao, "$(P):$(IPARAM)_SEND") {
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@leybold.proto set_int_floatE($(P):,$(CMD),$(IPARAM),$(FPARAM)) $(PORT)")
  field(PINI, "NO")
  field(FLNK, "$(P):$(IPARAM)_FORCE_READ")
}

# Record to force $(P):$(IPARAM)_REQUEST to process when a parameter is written to
# to verify the controller has taken the new value.
record(bo, "$(P):$(IPARAM)_FORCE_READ") {
  field(SCAN, "Passive")
  field(OUT, "$(P):$(IPARAM)_REQUEST.PROC PP")
  field(VAL, "1")
}
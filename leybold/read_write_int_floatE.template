# Send query to the controller
record(stringout, "$(P):$(IPARAM)_REQUEST") {
  field(SCAN, "$(SCAN)")
  field(DTYP, "stream")
  field(OUT, "@leybold.proto get_int_floatE($(P):,$(IPARAM),$(FPARAM),$(CMD),_RBV) $(PORT)")
  field(PINI, "YES")
}


# % archiver 10
record(ai, "$(P):$(FPARAM)_RBV") {
  field(PREC, "5")
}


# % autosave 1 VAL
record(ao, "$(P):$(FPARAM)") {
  field(PREC, "5")
  field(FLNK, "$(P):$(IPARAM)_SEND")
  field(DRVH, "$(DRVH)")
  field(DRVL, "$(DRVL)")
  field(VAL, "0")
}


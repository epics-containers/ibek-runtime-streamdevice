record(bo, "$(P):AUTOFOCUS")
{
    field(DTYP, "stream")
    field(OUT,  "@ptz.proto autofocus() $(PORT) 0")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SDIS, "$(P):DISABLE")
    field(FLNK, "$(P):GETFOCUS")
}

record(bo, "$(P):AUTOIRIS")
{
    field(DTYP, "stream")
    field(OUT,  "@ptz.proto autoiris() $(PORT) 0")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SDIS, "$(P):DISABLE")
    field(FLNK, "$(P):GETIRIS")
}

record(seq, "$(P):INITIALISE")
{
    field(SCAN, "2 second")
    field(SELM, "All")
    field(DOL1, "1")
    field(LNK1, "$(P):DISABLE PP")
    field(DOL2, "1")
    field(LNK2, "$(P):GETAUTOFOCUS PP")
    field(DOL3, "1")
    field(LNK3, "$(P):GETAUTOIRIS PP")
    field(DLY4, "2")
    field(DOL4, "1")
    field(LNK4, "$(P):INITIALISE2.PROC")
    field(DOL5, "1")
    field(LNK5, "$(P):INITIALISE.DISA")
}

record(seq, "$(P):INITIALISE2")
{
    field(SELM, "All")
    field(DOL1, "1")
    field(LNK1, "$(P):GETPAN PP")
    field(DOL2, "1")
    field(LNK2, "$(P):GETTILT PP")
    field(DOL3, "1")
    field(LNK3, "$(P):GETZOOM PP")
    field(DOL4, "1")
    field(LNK4, "$(P):GETFOCUS PP")
    field(DOL5, "1")
    field(LNK5, "$(P):GETIRIS PP")
    field(DLY6, "2")
    field(DOL6, "0")
    field(LNK6, "$(P):DISABLE PP")
}

record(longout, "$(P):DISABLE")
{
    field(VAL, "0")
}

record(ai, "$(P):GETAUTOFOCUS")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getautofocus($(P):AUTOFOCUS) $(PORT) 0")
}

record(ai, "$(P):GETAUTOIRIS")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getautoiris($(P):AUTOIRIS) $(PORT) 0")
}

record(ai, "$(P):GETPAN")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getpan($(P):PAN) $(PORT) 0")
}

record(ai, "$(P):GETTILT")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto gettilt($(P):TILT) $(PORT) 0")
}

record(ai, "$(P):GETZOOM")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getzoom($(P):ZOOM) $(PORT) 0")
}

record(ai, "$(P):GETFOCUS")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getfocus($(P):FOCUS) $(PORT) 0")
    field(SDIS, "$(P):AUTOFOCUS")
}

record(ai, "$(P):GETIRIS")
{
    field(DTYP, "stream")
    field(INP,  "@ptz.proto getiris($(P):IRIS) $(PORT) 0")
    field(SDIS, "$(P):AUTOIRIS")
}

#! Generated with the help of Claude (Anthropic)
# DG645 instrument-wide records: common IEEE-488.2, status, trigger and burst.
# Per-output records are in stanfordDG645Channel.template (delays, prescalers)
# and stanfordDG645Output.template (levels).
#
# Not exposed here: display select (DISP), interface configuration (IFCF,
# EPHY, IFRS, XTRM, LCAL, REMT, LOCK/UNLK) and calibration (CALT, CALL).
# They can change or break the connection, or alter factory calibration,
# so stanfordDG645.proto leaves them out too (see "Excluded commands" there).
#
# % macro, P, Device name
# % macro, PORT, Asyn port for device

# ===========================================================================
# Common IEEE-488.2 commands
# ===========================================================================

record(waveform, "$(P):IDN") {
  field(DESC, "Identification string")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto getIDN $(PORT)")
  field(FTVL, "CHAR")
  field(NELM, "128")
}

# Passive query: the screen's Run button writes .PROC to start it. The value is
# the result (0 ok, 17 failed). The device is busy for the whole calibration
# (see LockTimeout in the proto), and its duration is not given in the manual.
record(longin, "$(P):AUTOCAL") {
  field(DESC, "Run auto-cal (0 ok, 17 fail)")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto calibrate $(PORT)")
}

# Passive query: the screen's Run button writes .PROC to start it. The value is
# the result (0 ok, 16 failed). The manual says the unit is reset to its default
# settings after a self test, so this is not harmless on a configured unit.
record(longin, "$(P):SELFTEST") {
  field(DESC, "Run self test (resets settings)")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto selfTest $(PORT)")
}


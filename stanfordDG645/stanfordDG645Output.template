#! Generated with the help of Claude (Anthropic)
# DG645 front-panel output level configuration (amplitude, offset, polarity).
# Instantiate once per output:
#   CH=T0 BNC=0
#   CH=AB BNC=1
#   CH=CD BNC=2
#   CH=EF BNC=3
#   CH=GH BNC=4
#
# % macro, P, Device name
# % macro, PORT, Asyn port for device
# % macro, CH, Output name e.g. AB
# % macro, BNC, Output index (T0=0 AB=1 CD=2 EF=3 GH=4)

record(ao, "$(P):$(CH):AMP") {
  field(DESC, "Output amplitude")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@stanfordDG645.proto setLevelAmplitude($(BNC)) $(PORT)")
  field(PREC, "2")
  field(EGU, "V")
  field(DRVL, "0.5")
  field(DRVH, "5")
  field(FLNK, "$(P):$(CH):AMP_RBV")
}


#! Generated with the help of Claude (Anthropic)
# DG645 delay channel pair (e.g. AB = delays A and B) plus its output prescaler.
# Instantiate once per front-panel output:
#   CH=AB LEAD=2 TRAIL=3 PRESC=1
#   CH=CD LEAD=4 TRAIL=5 PRESC=2
#   CH=EF LEAD=6 TRAIL=7 PRESC=3
#   CH=GH LEAD=8 TRAIL=9 PRESC=4
#
# % macro, P, Device name
# % macro, PORT, Asyn port for device
# % macro, CH, Output name e.g. AB
# % macro, LEAD, Delay channel number of the leading edge (A=2 C=4 E=6 G=8)
# % macro, TRAIL, Delay channel number of the trailing edge (B=3 D=5 F=7 H=9)
# % macro, PRESC, Output prescaler index (AB=1 CD=2 EF=3 GH=4)

# ---------------------------------------------------------------------------
# Delay (leading edge relative to T0) and width (trailing edge relative to
# the leading edge)
# ---------------------------------------------------------------------------

record(ao, "$(P):$(CH):DELAY") {
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@stanfordDG645.proto setDelay($(LEAD),0) $(PORT)")
  field(PREC, "4")
  field(EGU, "s")
}

record(ao, "$(P):$(CH):WIDTH") {
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@stanfordDG645.proto setDelay($(TRAIL),$(LEAD)) $(PORT)")
  field(PREC, "4")
  field(EGU, "s")
}

record(ai, "$(P):$(CH):DELAY_RBV") {
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto getDelay($(LEAD)) $(PORT)")
  field(PREC, "4")
  field(EGU, "s")
}

record(ai, "$(P):$(CH):WIDTH_RBV") {
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto getDelay($(TRAIL)) $(PORT)")
  field(PREC, "4")
  field(EGU, "s")
}

# ---------------------------------------------------------------------------
# Leading edge: step and step size
# ---------------------------------------------------------------------------

record(bo, "$(P):$(CH):DELAY:STEP") {
  field(DESC, "Step delay by step size")
  field(SCAN, "Passive")
  # command only, no readback: do not alarm before first write
  field(UDFS, "NO_ALARM")
  field(DTYP, "stream")
  field(OUT, "@stanfordDG645.proto stepDelay($(LEAD)) $(PORT)")
  field(ZNAM, "Down")
  field(ONAM, "Up")
}

record(ao, "$(P):$(CH):DELAY:STEPSIZE") {
  field(DESC, "Delay step size")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@stanfordDG645.proto setStepDelay($(LEAD)) $(PORT)")
  field(PREC, "12")
  field(EGU, "s")
  field(FLNK, "$(P):$(CH):DELAY:STEPSIZE_RBV")
}

record(ai, "$(P):$(CH):DELAY:STEPSIZE_RBV") {
  field(DESC, "Delay step size")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@stanfordDG645.proto getStepDelay($(LEAD)) $(PORT)")
  field(PREC, "12")
  field(EGU, "s")
}


################################################################################
# enzLoCuM4Readback_generic_vertical.template
# Readback analogue signals from the enzLoCuM4 current amplifier.
#
# For BPM in vertical configuration i.e. (+Y, -X, +X, -Y)
#
# substitutions:
#% macro, device, device name
#% macro, egu, units for positions
#% macro, dtyp, DTYP of record for ai e.g. asynInt32
#% macro, pos_y, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, neg_x, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, pos_x, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, neg_y, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, dtyp_wf, DTYP of record for waveforms e.g. asynInt32ArrayIn
#% macro, pos_y_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, neg_x_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, pos_x_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, neg_y_wf, input link of record e.g. @asyn(ADC1 0)
#% macro, nelm, number of elements in waveform record
#% macro, desc_prefix, Prefix for descriptions. Used by screens. E.g. 'PBPM Blade'
################################################################################

include "enzLoCuM4Readback_generic_common.template"

#% archiver 1 Monitor
record(ai, "$(device):BLADE1") {
  field(DESC, "$(desc_prefix) 1")
  field(DTYP, "$(dtyp)")
  field(SCAN, ".1 second")
  field(INP, "$(pos_y)")
  field(EGU, "A")
  field(LINR, "LINEAR")
  field(EGUF, "1e-10")
  field(EGUL, "-1e-10")
  field(HOPR, "1e-10")
  field(LOPR, "-1e-10")
  field(HIGH, "0.9e-10")
  field(LOW, "-0.9e-10")
  field(HSV, "MINOR")
  field(LSV, "MINOR")
  field(MDEL, "-1")
  field(PREC, "5")
  field(FLNK, "$(device):BLADE2")
}


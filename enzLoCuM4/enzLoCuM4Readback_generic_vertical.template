record(stringout, "$(device):ORIENT_STR"){
  field(OUT, "$(device):ORIENT")
  field(PINI, "YES")
  field(VAL, "Vertical")
  field(DTYP, "Soft Channel")
}

record(bi, "$(device):ORIENT"){
  field(DTYP, "Soft Channel")
  field(INP, "$(device):ORIENT_STR CA")
  field(ZNAM, "Diagonal")
  field(ONAM, "Vertical")
}

#% archiver 1 Monitor
record(calc, "$(device):BEAMX") {
  field(INPA, "$(device):BLADE1 NPP")
  field(INPB, "$(device):BLADE2 NPP")
  field(INPC, "$(device):BLADE3 NPP")
  field(INPD, "$(device):BLADE4 NPP")
  field(INPE, "$(device):KX NPP")
  field(INPF, "$(device):OFFSETX NPP")
  field(CALC, "(C+B)=0?0:(E*(C-B)/(C+B))+F")
  field(FLNK, "$(device):BEAMY")
  field(PREC, "5")
  field(EGU, "$(egu)")
}

#% archiver 1 Monitor
record(calc, "$(device):BEAMY") {
  field(INPA, "$(device):BLADE1 NPP")
  field(INPB, "$(device):BLADE2 NPP")
  field(INPC, "$(device):BLADE3 NPP")
  field(INPD, "$(device):BLADE4 NPP")
  field(INPE, "$(device):KY NPP")
  field(INPF, "$(device):OFFSETY NPP")
  field(INPG, "$(device):ORIENT NPP")
  field(CALC, "(A+D)=0?0:(E*(A-D)/(A+D))+F")
  field(PREC, "5")
  field(EGU, "$(egu)")
}

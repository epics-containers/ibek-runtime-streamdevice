################################################################################
# enzLoCuM4Readback.template
# Hy8401ip specific readback analogue signals from the enzLoCuM4 current amplifier.
# Use enzLoCuM4Readback_generic.template for other input types
# M. Walters 2007-01-22
# based on original template by Ian Gillingham 9/March/2006
#
# Blade A +ve X +ve Y
# Blade B -ve X +ve Y
# Blade C -ve X -ve Y
# Blade D +ve X -ve Y
#
# substitutions:
#% macro, device, device name
#% macro, egu, units for positions
#% macro, blade_a_card, BLADE A logical card number
#% macro, blade_a_chan, BLADE A ADC channel number
#% macro, blade_b_card, BLADE B logical card number
#% macro, blade_b_chan, BLADE B ADC channel number
#% macro, blade_c_card, BLADE C logical card number
#% macro, blade_c_chan, BLADE C ADC channel number
#% macro, blade_d_card, BLADE D logical card number
#% macro, blade_d_chan, BLADE D ADC channel number
#% macro, desc_prefix, Prefix for descriptions. Used by screens. E.g. 'PBPM Blade'
#% macro, archiver_method, Optional macro defining the external archiver type
# Default is Monitor.  Leave blank for Sampled
#% macro, adel, Optional macro defining the archive deadband calculation.
# Default is 0.002 x Current value for 10V input
################################################################################
#% gdatag,template,bpm,$(gda_name=),$(gda_desc=)
record(transform, "$(device):UPDATE") {
  field(DESC, "Update values based on range")
  field(INPA, "$(device):CALMR CP")
  field(CMTB, "Current value for 10V input")
  field(CLCB, "10^INT((LOG(A)/LOG(2))-9.5)")
  field(OUTB, "$(device):FANEGUF PP")
  field(CMTC, "Current value for -10V input")
  field(CLCC, "-B")
  field(OUTC, "$(device):FANEGUL PP")
# factor of 0.98 comes from default value for maximum on autorange
  field(CMTD, "Upper limit")
  field(CLCD, "0.98*B")
  field(OUTD, "$(device):FANHIGH PP")
# factor of 0.08 comes from default value for minimum on autorange
  field(CMTE, "Lower limit")
  field(CLCE, "0.08*B")
  field(OUTE, "$(device):FANLOW PP")
  field(CMTF, "Archive deadband")
  field(CLCF, "$(adel=0.002*B)")
  field(OUTF, "$(device):FANADEL PP")
}

record(dfanout, "$(device):FANEGUF") {
  field(DESC, "Set EGUF of inputs")
  field(OUTA, "$(device):BLADEA.EGUF")
  field(OUTB, "$(device):BLADEB.EGUF")
  field(OUTC, "$(device):BLADEC.EGUF")
  field(OUTD, "$(device):BLADED.EGUF")
  field(OUTE, "$(device):BLADEA.HOPR")
  field(OUTF, "$(device):BLADEB.HOPR")
  field(OUTG, "$(device):BLADEC.HOPR")
  field(OUTH, "$(device):BLADED.HOPR")
}

record(dfanout, "$(device):FANEGUL") {
  field(DESC, "Set EGUL of inputs")

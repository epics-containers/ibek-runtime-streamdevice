  field(OUTE, "$(device):BLADEA.LOPR")
  field(OUTF, "$(device):BLADEB.LOPR")
  field(OUTG, "$(device):BLADEC.LOPR")
  field(OUTH, "$(device):BLADED.LOPR")
}

record(dfanout, "$(device):FANHIGH") {
  field(DESC, "Set HIGH of inputs")

  field(LINR, "LINEAR")
  field(EGUF, "1e-10")
  field(EGUL, "-1e-10")
  field(HOPR, "1e-10")
  field(LOPR, "-1e-10")
  field(HIGH, "0.9e-10")
  field(LOW, "-0.9e-10")
  field(HSV, "MINOR")
  field(LSV, "MINOR")

################################################################################
# enzLoCuM4Readback_generic_vertical.template
# Readback analogue signals from the enzLoCuM4 current amplifier.
#
# For BPM in diagonal configuration i.e. (+Y/-X, +Y/+X, -Y/-X, -Y/+X)
#
# substitutions:
#% macro, device, device name
#% macro, egu, units for positions
#% macro, dtyp, DTYP of record for ai e.g. asynInt32
#% macro, top_left, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, top_right, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, bottom_left, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, bottom_right, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, dtyp_wf, DTYP of record for waveforms e.g. asynInt32ArrayIn
#% macro, top_left_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, top_right_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, bottom_left_wf, input link of record e.g. @asyn(ADC1 0)GENDATA
#% macro, bottom_right_wf, input link of record e.g. @asyn(ADC1 0)
#% macro, nelm, number of elements in waveform record
#% macro, desc_prefix, Prefix for descriptions. Used by screens. E.g. 'PBPM Blade'
################################################################################

include "enzLoCuM4Readback_generic_common.template"

#% archiver 1 Monitor
record(ai, "$(device):BLADE1") {
  field(DESC, "$(desc_prefix) 1")
  field(DTYP, "$(dtyp)")
  field(SCAN, ".1 second")
  field(INP, "$(top_right)")
  field(EGU, "A")
  field(LINR, "LINEAR")
  field(EGUF, "1e-10")
  field(EGUL, "-1e-10")
  field(HOPR, "1e-10")
  field(LOPR, "-1e-10")
  field(HIGH, "0.9e-10")
  field(LOW, "-0.9e-10")
  field(HSV, "MINOR")
  field(LSV, "MINOR")
  field(MDEL, "-1")
  field(PREC, "5")
  field(FLNK, "$(device):BLADE2")
}


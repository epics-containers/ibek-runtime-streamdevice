record(calc, "$(device):MEAN:N")
{
    field(DESC, "Number of good IMGs")
    field(INPA, "$(device):MEAN:G1")
    field(INPB, "$(device):MEAN:G2")
    field(INPC, "$(device):MEAN:G3")
    field(INPD, "$(device):MEAN:G4")
    field(INPE, "$(device):MEAN:G5")
    field(INPF, "$(device):MEAN:G6")
    field(INPG, "$(device):MEAN:G7")
    field(INPH, "$(device):MEAN:G8")
    field(INPI, "$(device):MEAN:G9")
    field(INPJ, "$(device):MEAN:G10")
    field(CALC, "(A#0)+(B#0)+(C#0)+(D#0)+(E#0)+(F#0)+(G#0)+(H#0)+(I#0)+(J#0)")
    field(FLNK, "$(device):MEAN:STA")
}

record(calcout, "$(device):MEAN:STA")
{
    field(DESC, "Mean status")
    field(INPA, "$(device):MEAN:N")
    field(INPB, "$(nimgs)")
    field(CALC, "A=0?11:(A=B?0:1)")
    field(OOPT, "Every Time")
    field(OUT,  "$(device):STA PP")
    field(FLNK, "$(device):MEAN:P")
}

record(calcout, "$(device):MEAN:P")
{
    field(DESC, "Mean pressure")
    field(INPA, "$(device):MEAN:G1")
    field(INPB, "$(device):MEAN:G2")
    field(INPC, "$(device):MEAN:G3")
    field(INPD, "$(device):MEAN:G4")
    field(INPE, "$(device):MEAN:G5")
    field(INPF, "$(device):MEAN:G6")
    field(INPG, "$(device):MEAN:G7")
    field(INPH, "$(device):MEAN:G8")
    field(INPI, "$(device):MEAN:G9")
    field(INPJ, "$(device):MEAN:G10")
    field(INPL, "$(device):MEAN:N")
    field(CALC, "L>0?(A+B+C+D+E+F+G+H+I+J)/L:0")
    field(PREC, "11")
    field(OOPT, "Every Time")
    field(OUT,  "$(device):P PP")
    field(FLNK, "$(device):MEAN:PMAX")
}


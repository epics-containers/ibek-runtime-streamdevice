    field(INPI, "$(device):MEAN:G9")
    field(INPJ, "$(device):MEAN:G10")
    field(INPK, "1.01e-3")
    field(CALC, "MIN(A?A:K,B?B:K,C?C:K,D?D:K,E?E:K,F?F:K,G?G:K,H?H:K,I?I:K,J?J:K)")
    field(PREC, "11")
    field(OOPT, "Every Time")
    field(OUT,  "$(device):PMIN PP")
}


    field(INPH, "$(device):MEAN:G8")
    field(INPI, "$(device):MEAN:G9")
    field(INPJ, "$(device):MEAN:G10")
    field(INPK, "1.99e-11")
    field(CALC, "MAX(A,B,C,D,E,F,G,H,I,J,K)")
    field(PREC, "11")
    field(OOPT, "Every Time")
    field(OUT,  "$(device):PMAX PP")
    field(FLNK, "$(device):MEAN:PMIN")
}


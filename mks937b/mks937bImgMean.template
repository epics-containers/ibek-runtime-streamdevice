# mks937bImgMean.template
# Translated from mks937b 2-98 db/mks937bImgMean.template: aSub mks937bMeanCalc
# replaced by base calc records. Same values, written every scan as the aSub did.
# One difference: if a gauge's input link fails (e.g. a disconnected PV from
# another IOC), the aSub froze all four outputs; here only that gauge's
# MEAN:G<n> keeps its last value and the mean carries on.
#% macro, __doc__, Template database to calculate the mean pressure from a 
# number of IMGs
# Pete Owens - 26/6/06
#
# substitutions:
#% macro, device, device name
#% macro, current, beam current
#% macro, nimgs, number of gauges
#% macro, img1, img 1 device name
#% macro, img2, img 2 device name
#% macro, img3, img 3 device name
#% macro, img4, img 4 device name
#% macro, img5, img 5 device name
#% macro, img6, img 6 device name
#% macro, img7, img 7 device name
#% macro, img8, img 8 device name
#% macro, img9, img 9 device name
#% macro, img10, img 10 device name

################################################################################
# Mean Pressure
#
# was: record(aSub ...) MEAN, INAM mks937bMeanInit, SNAM mks937bMeanCalc,
#   EFLG "ON CHANGE", SCAN "1 second", PHAS 2; INPA nimgs, INPB-K img1-10 :P,
#   INPL-U img1-10 :STA; OUTA-D :STA, :P, :PMAX, :PMIN, each PP.
# The fanout keeps the record's name, scan and archiver tag, and drives this
# chain once per scan, in this order:
#   MEAN:G1..G10 - gauge n's pressure if n <= nimgs, its status is 0 or 1 and
#                  1.99e-11 <= P <= 1.01e-3, otherwise 0. A good pressure is
#                  never 0, so G<n> # 0 marks a good gauge.
#   MEAN:N       - the number of good gauges.
#   MEAN:STA     - writes :STA: 11 if no gauge is good, 0 if all
#                  nimgs are, otherwise 1.
#   MEAN:P       - writes :P: the good pressures summed left to right,
#                  as mks937bMeanCalc does, over N; 0 if N is 0.
#   MEAN:PMAX    - writes :PMAX: the largest good pressure, or
#                  1.99e-11 if there is none.
#   MEAN:PMIN    - writes :PMIN: the smallest good pressure, or
#                  1.01e-3 if there is none.
# Like the aSub, every scan writes all four outputs (EFLG governed only the
# aSub's own VALA-VALD monitors), so OOPT is "Every Time".
#% archiver 1 Monitor
#
record(fanout, "$(device):MEAN")
{
    field(DESC, "Mean Pressure")
    field(SCAN, "1 second")
    field(PHAS, "2")
    field(SELM, "All")
    field(LNK1, "$(device):MEAN:G1")
}

record(calc, "$(device):MEAN:G1")
{
    field(DESC, "IMG 1 pressure if good, else 0")
    field(INPA, "$(img1):P")
    field(INPB, "$(img1):STA")
    field(INPC, "$(nimgs)")
    field(CALC, "(C>=1&&(B=0||B=1)&&A>=1.99e-11&&A<=1.01e-3)?A:0")
    field(PREC, "11")
    field(FLNK, "$(device):MEAN:G2")
}


# Scientific Instruments SCM10 single channel temperature monitor.
#
# Nothing is written to the instrument at start-up: each output record reads
# the instrument's current value (the @init handler in
# scientificInstSCM10.proto), and there is no autosave. What the IOC shows is
# what the instrument has.
#
# % macro, P, Device prefix
# % macro, PORT, Asyn port for device

# ===========================================================================
# Identity
# ===========================================================================

record(waveform, "$(P):IDN_RBV") {
  field(DESC, "Identification string")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getIDN $(PORT)")
  field(FTVL, "CHAR")
  field(NELM, "128")
}

# Read once at start-up like IDN; neither changes while running.
record(stringin, "$(P):VERSION_RBV") {
  field(DESC, "Firmware version")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getVersion $(PORT)")
}

record(waveform, "$(P):DOM_RBV") {
  field(DESC, "Date of manufacture and serial number")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getDOM $(PORT)")
  field(FTVL, "CHAR")
  field(NELM, "64")
}

record(stringin, "$(P):IP_RBV") {
  field(DESC, "Device static IP address")
  field(SCAN, "10 second")
  field(PINI, "YES")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getIP $(PORT)")
}

# ===========================================================================
# Readings
# ===========================================================================

# The instrument measures at up to 5 readings a second.
record(ai, "$(P):TEMP_RBV") {
  field(DESC, "Temperature")
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getTemperature $(PORT)")
  field(EGU, "K")
  field(PREC, "3")
  info(archive, "monitor 1: VAL")
}

# Volts for a diode curve, ohms for an RTD curve, so there is no EGU.
record(ai, "$(P):SENSOR_RBV") {
  field(DESC, "Sensor reading (V diode, ohm RTD)")
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getSensor $(PORT)")
  field(PREC, "5")
}

record(mbbi, "$(P):ERROR_RBV") {
  field(DESC, "Instrument error status")
  field(SCAN, "1 second")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getError $(PORT)")
  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(THVL, "3")
  field(FRVL, "4")
  field(FVVL, "5")
  field(SXVL, "6")
  field(ZRST, "No error")
  field(ONST, "ADC error")
  field(TWST, "Open sensor")
  field(THST, "Sensor input too high")
  field(FRST, "Sensor input too low")
  field(FVST, "No active curve")
  field(SXST, "Outside curve")
  field(ZRSV, "NO_ALARM")
  field(ONSV, "MAJOR")
  field(TWSV, "MAJOR")
  field(THSV, "MAJOR")
  field(FRSV, "MAJOR")
  field(FVSV, "MAJOR")
  field(SXSV, "MAJOR")
}

# ===========================================================================
# Sensor and filter
# ===========================================================================

record(mbbo, "$(P):CURVE") {
  field(DESC, "Sensor curve")
  field(SCAN, "Passive")
  field(DTYP, "stream")

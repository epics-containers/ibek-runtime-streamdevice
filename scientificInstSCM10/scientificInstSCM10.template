  field(TWVL, "2")
  field(THVL, "3")
  field(FRVL, "4")
  field(FVVL, "5")
  field(SXVL, "6")
  field(SVVL, "7")
  field(EIVL, "8")
  field(NIVL, "9")
  field(TEVL, "10")
  field(ZRST, "None")
  field(ONST, "Si410")
  field(TWST, "Si430")
  field(THST, "DT470")
  field(FRST, "DT670")
  field(FVST, "PT100")
  field(SXST, "PT1000")
  field(SVST, "RO600")
  field(EIST, "RO105")
  field(NIST, "CTI")
  field(TEST, "User")
}

record(longout, "$(P):FILTER") {
  field(DESC, "Noise filter, 0 off to 9 most")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@scientificInstSCM10.proto setFilter $(PORT)")
  field(DRVL, "0")
  field(DRVH, "9")
  field(LOPR, "0")
  field(HOPR, "9")
  field(FLNK, "$(P):FILTER_RBV")
}

record(longin, "$(P):FILTER_RBV") {
  field(DESC, "Noise filter, 0 off to 9 most")
  field(SCAN, "5 second")
  field(DTYP, "stream")
  field(INP, "@scientificInstSCM10.proto getFilter $(PORT)")
}


  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(THVL, "3")
  field(FRVL, "4")
  field(FVVL, "5")
  field(SXVL, "6")
  field(SVVL, "7")
  field(EIVL, "8")
  field(NIVL, "9")
  field(TEVL, "10")
  field(ZRST, "None")
  field(ONST, "Si410")
  field(TWST, "Si430")
  field(THST, "DT470")
  field(FRST, "DT670")
  field(FVST, "PT100")
  field(SXST, "PT1000")
  field(SVST, "RO600")
  field(EIST, "RO105")
  field(NIST, "CTI")
  field(TEST, "User")
  field(FLNK, "$(P):CURVE_RBV")
}

record(mbbi, "$(P):CURVE_RBV") {
  field(DESC, "Sensor curve")
  field(SCAN, "5 second")
  field(DTYP, "stream")

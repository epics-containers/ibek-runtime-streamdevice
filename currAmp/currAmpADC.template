  field(EGU, "uA")
  field(PREC, "4")
  field(HOPR, "100")
  field(LOPR, "0.0000001")
  field(HHSV, "MAJOR")
  field(LLSV, "MAJOR")
  field(INPC, "$(P):B2ADC.VAL")
}


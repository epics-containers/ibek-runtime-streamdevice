  field(HHSV, "MAJOR")
  field(LLSV, "MAJOR")
  field(FLNK, "$(P):INTEN_ADC_C")
  field(INPC, "$(P):A2ADC.VAL")
}

record(calcout, "$(P):INTEN_ADC_C") {
  field(DESC, "Calibrated intensity")
  field(SCAN, "Passive")
  field(CALC, "A+B+C+D")
  field(INPA, "$(P):PHD1:I_ADC_C.VAL")
  field(INPB, "$(P):PHD2:I_ADC_C.VAL")
  field(INPC, "$(P):PHD3:I_ADC_C.VAL")
  field(INPD, "$(P):PHD4:I_ADC_C.VAL")
  field(EGU, "uA")
  field(OUT, "$(P):INTEN_ADC_N.A PP")
}


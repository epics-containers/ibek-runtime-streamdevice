# This file covers the stream device protocols for both types
# of current amplifiers (ymcs0012 and ymcs0009)
# Original author: Igor Verstovsek (Cosylab)
# Additional authors: Denis Ivanic, Rok Sabjan (Cosylab)
# Last change: 2005-07-28
#
# Changelog:
# 2005-07-28 (rs): Additional function added for ymcs0009

InTerminator = LF;
OutTerminator = LF;
ReplyTimeout = 1000;
ReadTimeout  = 200;
LockTimeout = 60000;

# Reset the device
reset { out "*RST\$1"; in "\6"; InTerminator = ""; wait 5; }

# Read as a long in the range [0..2^20=1048576]
readCurr { out ":READ\$1:CURR\$2?"; in "\6%d"; wait 5;}

# Read as a double
readPos { out ":READ\$1:POS\$2?"; in "\6%f"; wait 5; }

# Read range number
readRang { out ":CONF\$1:CURR:RANG?"; in "\6%d"; wait 5; }
setRang {out ":CONF\$1:CURR:RANG %d"; in "\6"; InTerminator = ""; wait 5;
	@init {out ":CONF\$1:CURR:RANG?"; in "\6%d" LF; }
	}

# Gain parameters
readGL { out ":CONF\$1:\$2?"; in "\6%d"; wait 5; }
setGL  {out ":CONF\$1:\$2 %d"; in "\6"; InTerminator = ""; wait 5;
	@init {out ":CONF\$1:\$2?"; in "\6%d" LF; wait 5; }
	}

readGF { out ":CONF\$1:\$2?"; in "\6%f"; wait 5; }
setGF  {out ":CONF\$1:\$2 %f"; in "\6"; InTerminator = ""; wait 5; 
	@init {out ":CONF\$1:\$2?"; in "\6%f" LF; wait 5; }
	}

# Averaging and filtering
readMode {out ":CONF\$1:MODE?"; in "\6%d"; wait 5; }
setSingle { out ":CONF\$1:SINGLE"; in "\6"; InTerminator = ""; wait 5; }
setAvg {out ":CONF\$1:AVGCURR %d"; in "\6"; InTerminator = ""; wait 5; }
setWdw {out ":CONF\$1:WDWCURR %d"; in "\6"; InTerminator = ""; wait 5; }

# Reading and setting the high voltage (ymcs0009 only)

setHV { out ":CONF\$1:VOLT %d"; InTerminator = "";
        @init { out ":CONF\$1:VOLT?"; in "\6%d" LF; wait 5; }
	}
getHV { out ":CONF\$1:VOLT?"; in "\6%d"; wait 5; }

# Reading the channels for reading a-d values (ymcs0009 only)
getChannel { out ":READ\$1:\$2?"; in "\6%s"; wait 5; }


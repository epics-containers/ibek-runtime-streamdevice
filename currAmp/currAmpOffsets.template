# This database instantiates six templates which allow you to define a set of offsets
# to be applied for each range of the current amplifier.  It works with both the
# YMCS0009 and YMCS0012 models as they have the same number of ranges.
substitute "_RANGE=6"

include "currAmpRange.template"


substitute "_RANGE=5"

include "currAmpRange.template"


substitute "_RANGE=4"

include "currAmpRange.template"


substitute "_RANGE=3"

include "currAmpRange.template"


substitute "_RANGE=2"

include "currAmpRange.template"


substitute "_RANGE=1"

include "currAmpRange.template"


# First apply the offset and then calibrate using the current range.
record(calcout, "$(P):PHD1:I_C") {
  field(DESC, "Calibrated current 1")
  field(CALC, "((A-C)/1048575)*B")
  field(INPA, "$(P):PHD1:I_R.VAL CP")
  field(INPB, "$(P):RANGE_HI.VAL")
  field(INPC, "$(P):C2_SP")
  field(OUT, "$(P):INTEN_C.A PP")
  field(EGU, "uA")
  field(PREC, "4")
  field(HOPR, "100")
  field(LOPR, "0.0000001")
}


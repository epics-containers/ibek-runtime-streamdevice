#% gdatag,pv,ro,$(gda_bpm_name=),CAL_INTENSITY,Intensity calibrated with offsets
record(calcout, "$(P):INTEN_C") {
  field(DESC, "Calibrated intensity")
  field(SCAN, "Passive")
  field(CALC, "A+B+C+D")
  field(OUT, "$(P):INTEN_N.A PP")
  field(EGU, "uA")
  field(PREC, "4")
  field(HOPR, "2800")
  field(LOPR, "0")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# Normalize the intensity with respect to the beam current.
# First check that the beam is greater than 1mA, if not set to zero and MAJOR alarm status.
#% gdatag,pv,ro,$(gda_bpm_name=),NORM_INTENSITY,Intensity normalized to ring current
record(calc, "$(P):INTEN_N") {
  field(DESC, "Normalized intensity")
  field(CALC, "B>1?(A/B)*100:0")
  field(INPB, "$(SIGNAL=SR-DI-DCCT-01:SIGNAL)")
  field(PREC, "4")
  field(LOW, "0")
  field(LSV, "MAJOR")
}

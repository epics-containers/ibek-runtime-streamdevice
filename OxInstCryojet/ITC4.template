record(fanout, "$(P)$(Q):FAN1") {
  field(SCAN, "2 second")
  field(SDIS, "$(P)$(Q):DISABLE")
  field(SELM, "All")
  field(LNK1, "$(P)$(Q):STEMP")
  field(LNK2, "$(P)$(Q):STEMP2")
  field(LNK3, "$(P)$(Q):STEMP3")

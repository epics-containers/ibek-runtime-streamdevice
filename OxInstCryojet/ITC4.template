# Modified version of cryojetITC503S.vdb for the ITC4 unit.


#% gdatag,template,OxInstCryojet,$(gda_name=),$(gda_desc=)
#% gdatag,pv,rw,$(gda_name=),PGAIN_SET
#% autosave 1 VAL
record(ao, "$(P)$(Q):P:SET") {
  field(DESC, "Set PID P")
  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@itc4.proto set_p $(PORT) 0")
  field(OMSL, "supervisory")
  field(PREC, "1")
  field(DRVH, "999.99")
  field(DRVL, "0")
}


# % macro, __doc__, Control for Oxford N-Helix 700 series
#
# Macros:
# % macro, P, Device Prefix
# % macro, Q, Device suffix
# % macro, PORT, Asyn port to connect to
# % macro, gda_name, Name in gda interface file (Default = )
# % macro, gda_desc, Description in gda interface file (Default = )
# % macro, name, Object and gui association name
# % macro, CTEMP_MIN, macro to set minimum target temperature
# % macro, CTEMP_MAX, macro to set maximum target temperature
#% gui, $(name=), edm, OXNH700.edl, CS=$(P)$(Q)
#% gui, $(name=), edmembed, OXNH700_embed.edl, P=$(P),Q=$(Q)

# %gdatag,template,OXNH700,$(gda_name=),$(gda_desc=)

# % archiver 1 Monitor
# %gdatag,mbbinary,ro,$(gda_name=),PHASE
record(mbbi, "$(P)$(Q):PHASE") {
  field(DESC, "Phase ID")
  field(DTYP, "Raw Soft Channel")
  field(PINI, "YES")
  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(THVL, "3")
  field(FRVL, "4")
  field(FVVL, "5")
  field(SXVL, "6")
  field(SVVL, "7")
  field(EIVL, "8")
  field(NIVL, "9")
  field(TEVL, "10")
  field(ZRST, "Ramp")
  field(ONST, "Cool")
  field(TWST, "Plat")
  field(THST, "Hold")
  field(FRST, "End")
  field(FVST, "Purge")
  field(SXST, "Delete Phase")
  field(SVST, "Load Program")
  field(EIST, "Save Program")
  field(NIST, "Soak")
  field(TEST, "Wait")
}

substitute "_CTEMP_DRVL=$(CTEMP_MIN=20)"
substitute "_CTEMP_DRVH=$(CTEMP_MAX=327.67)"

include "OXcommonCB.template"


#% gui, $(name=), sevr
record(ai, "$(P)$(Q):STATUS") {
  field(SCAN, ".5 second")
  field(DTYP, "stream")
  field(VAL, "1")
  field(INP, "@OXNH700.proto read($(P)$(Q)) $(PORT)")
  field(SDIS, "$(P)$(Q):DISABLE")  
}


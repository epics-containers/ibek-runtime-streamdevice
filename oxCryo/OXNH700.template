# 0 - Auto gas select
# 1 - Always use He
# % archiver 1 Monitor
record(bi, "$(P)$(Q):FORCEHEMODE") {
  field(DESC, "Force He Mode Readback")
  field(DTYP, "Raw Soft Channel")
  field(PINI, "YES")
  field(ZNAM, "Auto")
  field(ONAM, "He")
}

# % archiver 1 Monitor
# %autosave 1 VAL
record(bo, "$(P)$(Q):FORCEHE") {
  field(DTYP, "Raw Soft Channel")
  field(ZNAM, "Auto")
  field(ONAM, "Force He")
  field(FLNK, "$(P)$(Q):FORCEHECMD")
  field(RVAL, "0")
  field(PINI, "YES")
}

record(ao, "$(P)$(Q):FORCEHECMD") {
  field(DTYP, "stream")
  field(OUT, "@OXNH700.proto forcehe($(P)$(Q)) $(PORT)")
  field(SDIS, "$(P)$(Q):DISABLE")
}

# This PV keeps the GUI ForceHe dropdown display in sync with the RBV
# e.g. if the IOC is restarted when the ForceHe MODE is On
record(calc, "$(P)$(Q):FORCEHERBV_SYNC") {
  field(DESC, "For syncing GUI only")
  field(INPA, "$(P)$(Q):FORCEHEMODE CP")
  field(CALC, "A==0 || A==1")
}

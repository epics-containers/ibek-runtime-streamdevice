# % macro, __doc__, Control for Oxford cryostream 700 series (Phenix)
#
# Macros:
# % macro, P, Device Prefix
# % macro, Q, Device suffix
# % macro, PORT, Asyn port to connect to
# % macro, CTEMP_MIN, macro to set minimum target temperature
# % macro, CTEMP_MAX, macro to set maximum target temperature


record(mbbi, "$(P)$(Q):PHASE") {
  field(DESC, "Phase Id")
  field(DTYP, "Raw Soft Channel")
  field(PINI, "YES")
  field(ZRVL, "0")
  field(ONVL, "1")
  field(TWVL, "2")
  field(THVL, "3")
  field(FVVL, "4")
  field(SXVL, "5")
  field(SVVL, "6")
  field(EIVL, "7")
  field(NIVL, "8")
  field(TEVL, "19")
  field(ZRST, "Ramp")
  field(ONST, "Cool")
  field(TWST, "Plat")
  field(THST, "Hold")
  field(FRST, "Unused")
  field(FVST, "Warm")
  field(SXST, "Delete Phase")
  field(SVST, "Load Program")
  field(EIST, "Save Program")
  field(NIST, "Soak")
  field(TEST, "Wait")
}

substitute "_CTEMP_DRVL=$(CTEMP_MIN=80)"
substitute "_CTEMP_DRVH=$(CTEMP_MAX=327.67)"

include "OXcommon.template"


record(ai, "$(P)$(Q):STATUS") {
  field(SCAN, ".5 second")
  field(DTYP, "stream")
  field(VAL, "1")
  field(INP, "@OXCS700.proto read($(P)$(Q)) $(PORT)")
  field(SDIS, "$(P)$(Q):DISABLE")
}

record(ao, "$(P)$(Q):RTEMP") {
  field(DESC, "Ramp Target Temp")
  field(DTYP, "Raw Soft Channel")
  field(PINI, "YES")
  field(LINR, "LINEAR")
  field(ESLO, "0.01")
  field(EOFF, "0")
  field(PREC, "2")
  field(EGU, "K")
  field(DRVL, "11.00")
  field(DRVH, "300.00")
  field(FLNK, "$(P)$(Q):RTEMPCH")
}


record(ai, "$(P)$(Q):CSTYPE") {
  field(DESC, "Cryostream type")
  field(PINI, "YES")
  field(VAL, "1")
}


record(ai, "$(P)$(Q):BACKPRESS") {
  field(DESC, "Cryo Status")
  field(DTYP, "Raw Soft Channel")
  field(PINI, "YES")
}

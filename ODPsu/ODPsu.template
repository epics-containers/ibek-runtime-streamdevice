

# ODPsu.template
# substitutions
# P - device name prefix (name will be $(P)$(Q))
# Q - device name qualifier (name will be $(P)$(Q))
# PORT - the comms port
# % macro, P, device name prefix (name will be $(P)$(Q))
# % macro, Q, device name qualifier (name will be $(P)$(Q))
# % macro, PORT, Asyn port name

record(bo, "$(P)$(Q):DISABLE") {
  field(DESC, "Disable comms")
  field(PINI, "YES")
  field(VAL, "0")
  field(OMSL, "supervisory")
  field(ZNAM, "Enabled")
  field(ONAM, "Disabled")
}

record(bo, "$(P)$(Q):VR") {
  field(DESC, "Send readback cmd")
  field(SCAN, "5 second")
  field(DTYP, "stream")
  field(OUT, "@ODPsu.protocol getvall $(PORT) 0")
  field(SDIS, "$(P)$(Q):DISABLE")
}

record(longout, "$(P)$(Q):FMT:GET") {
  field(DESC, "Send read format cmd")
  field(SCAN, "Passive")
#  field(SCAN, "Passive")
  field(DTYP, "stream")
  field(OUT, "@ODPsu.protocol getvdformat $(PORT) 0")
  field(SDIS, "$(P)$(Q):DISABLE")
  field(HOPR, "7")
  field(LOPR, "0")
  field(STAT, "NO_ALARM")
  field(SEVR, "NO_ALARM")
  field(DOL, "0")
  field(OMSL, "supervisory")
  field(DRVH, "7")
  field(DRVL, "0")
}

record(longin, "$(P)$(Q):FORMAT") {
  field(DESC, "Setup: Get active format")
  field(INP, "$(P)$(Q):SETUP:P1")
}

record(ai, "$(P)$(Q):TIME:RESET") {
  field(DESC, "Setup: Get reset time")
  field(INP, "$(P)$(Q):SETUP:P2")
  field(EGU, "h")
  field(PREC, "2")
}



# ODPsugda.template
# % macro, P, device name prefix (name will be $(P)$(Q))
# % macro, Q, device name qualifier (name will be $(P)$(Q))
# % macro, BANK, power supply bank number (0 - 1)
# % macro, BSTART, Bstart substitution ?
# % macro, PV, PV substitution ?
# % macro, DLY, DLY substitution ?
record(calcout, "$(P)$(Q):GDA:B$(BANK):CNT5") {
  field(DESC, "if A=8+$(BSTART)-1")
  field(CALC, "A=(8+$(BSTART)-1)?1:0")
  field(INPA, "$(P)$(Q):GDA:B$(BANK):CNT.VAL")
  field(OUT, "$(PV):VOUT.PROC")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use CALC")
  field(FLNK, "$(P)$(Q):GDA:B$(BANK):CNT6")
}

record(compress, "$(P)$(Q):GDA:B$(BANK):CMP") {
  field(FLNK, "$(P)$(Q):GDA:B$(BANK):CNT5")
  field(INP, "$(P)$(Q):GDA:B$(BANK):SEL2.VAL")
  field(ALG, "Circular Buffer")
  field(NSAM, "8")
  field(HOPR, "10000")
  field(LOPR, "0")
}

record(sel, "$(P)$(Q):GDA:B$(BANK):SEL2") {
  field(SELM, "Specified")
  field(INPA, "$(P)$(Q):GDA:B$(BANK):SEL0.VAL")
  field(INPB, "$(P)$(Q):GDA:B$(BANK):SEL1.VAL")
}


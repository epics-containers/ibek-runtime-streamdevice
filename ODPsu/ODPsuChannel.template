record(longin, "$(P)$(Q):FMT:V$(CHAN)DR") {
  field(DESC, "V$(CHAN) fmt demand rb")
  field(HOPR, "2000")
  field(LOPR, "-2000")
  field(EGU, "V")
}

# outputs zero if the streams record
# is active
# Otherwise 1 or 2 based on the
# severity of the result
record(calcout, "$(P)$(Q):V$(CHAN)DSEVC") {
  field(FLNK, "$(P)$(Q):V$(CHAN)DSEV")
  field(CALC, "(A>0)?2:1")
  field(INPA, "$(P)$(Q):V$(CHAN)D:SET.SEVR")
  field(DESC, "Raise severity if FAIL")
  field(OUT, "$(P)$(Q):V$(CHAN)DSEV")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

# zero if No request processed
# one if ok
# two if FAIL
record(mbbo, "$(P)$(Q):V$(CHAN)DSEV") {
  field(DESC, "Raise alarm if set failed")
  field(ZRST, "N/A")
  field(ONST, "OK")
  field(TWST, "FAIL")
  field(THST, "SLEW")
  field(ZRSV, "NO_ALARM")
  field(ONSV, "NO_ALARM")
  field(TWSV, "MAJOR")
  field(THSV, "NO_ALARM")
  field(FLNK, "$(P)$(Q):V$(CHAN)DR:GET")
}

# sequence to reset the VxDSEV field to N/A
record(seq, "$(P)$(Q):V$(CHAN)DSEQ") {
  field(FLNK, "$(P)$(Q):V$(CHAN)D:CALC")
  field(DO1, "3")
  field(LNK1, "$(P)$(Q):V$(CHAN)DSEV PP")
}


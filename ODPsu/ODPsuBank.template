

# ODPsuBank.template
# substitutions
# P - device name prefix (name will be $(P)$(Q))
# Q - device name qualifier (name will be $(P)$(Q))
# BANK - the bank (0 or 1)
# PORT - the comm port
# % macro, P, device name prefix (name will be $(P)$(Q))
# % macro, Q, device name qualifier (name will be $(P)$(Q))
# % macro, BANK, power supply bank number (0 - 1)
# % macro, PORT, Asyn port name
record(longout, "$(P)$(Q):B$(BANK)MIN:SET") {
  field(DESC, "Set bank$(BANK) min v")
  field(SCAN, "Passive")
  field(SDIS, "$(P)$(Q):DISABLE")
  field(DTYP, "stream")
  field(OUT, "@ODPsu.protocol setmin($(BANK)) $(PORT) 0")
  field(HOPR, "2000")
  field(LOPR, "-2000")
  field(EGU, "V")
  field(STAT, "NO_ALARM")
  field(SEVR, "NO_ALARM")
  field(FLNK, "$(P)$(Q):SETUP:GET")
}


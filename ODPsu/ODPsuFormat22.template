

# ODPsuFormat16.template
# substitutions
# P - device name prefix (name will be $(P)$(Q))
# Q - device name qualifier (name will be $(P)$(Q))
# PORT - the comms port
# % macro, P, device name prefix (name will be $(P)$(Q))
# % macro, Q, device name qualifier (name will be $(P)$(Q))
# % macro, PORT, Asyn port name
record(bo, "$(P)$(Q):FMT:SET") {
  field(FLNK, "$(P)$(Q):FMT:SETSEQ")
}

record(longout, "$(P)$(Q):FMT:ID:OUT") {
  field(DESC, "send corr interval")
  field(SDIS, "$(P)$(Q):DISABLE")
  field(DTYP, "stream")
  field(PRIO, "HIGH")
  field(FLNK, "$(P)$(Q):FMT:BANK:OUT")
  field(OUT, "@ODPsu.protocol setvdformat0 $(PORT) 0")
  field(DOL, "$(P)$(Q):FMT:GET")
  field(OMSL, "closed_loop")
  field(DRVH, "7")
  field(DRVL, "0")
}


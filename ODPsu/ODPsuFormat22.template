record(calcout, "$(P)$(Q):FMTDSEVC") {
  field(FLNK, "$(P)$(Q):FMTDSEV")
  field(CALC, "(A>0)?2:1")
  field(INPA, "$(P)$(Q):FMT:V13D:OUT.SEVR")
  field(DESC, "Raise severity if FAIL")
  field(OUT, "$(P)$(Q):FMTDSEV.VAL")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
}

record(mbbo, "$(P)$(Q):FMTDSEV") {
  field(DESC, "Raise alarm if set failed")
  field(ZRST, "N/A")
  field(ONST, "OK")
  field(TWST, "FAIL")
  field(ZRSV, "NO_ALARM")
  field(ONSV, "NO_ALARM")
  field(TWSV, "MAJOR")
  field(FLNK, "$(P)$(Q):FMT:CONT")
}

# continue the request only if received SUCCESS
record(calcout, "$(P)$(Q):FMT:CONT") {
  field(CALC, "(A=1)?1:0")
  field(INPA, "$(P)$(Q):FMTDSEV")
  field(OUT, "$(P)$(Q):FMT:ID:OUT2 PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use CALC")
}

